+    /**
+     * After a task is removed the page scrolls are only recomputed on the next layout. Snap again
+     * once the layout is done so the remaining cards end up centered and stacked correctly
+     * (otherwise a gap can be left in the middle).
+     */
+    private void resnapAfterLayout(final int page) {
+        getViewTreeObserver().addOnPreDrawListener(new ViewTreeObserver.OnPreDrawListener() {
+            @Override
+            public boolean onPreDraw() {
+                getViewTreeObserver().removeOnPreDrawListener(this);
+                int taskCount = getTaskViewCount();
+                if (taskCount == 0) {
+                    return true;
+                }
+                for (int i = 0; i < taskCount; i++) {
+                    TaskView taskView = getTaskViewAt(i);
+                    if (taskView.getTranslationX() != 0f) {
+                        taskView.setTranslationX(0f);
+                    }
+                }
+                snapToPageImmediately(Utilities.boundToRange(page, 0, taskCount - 1));
+                updateCurveProperties();
+                // Skip this frame; the scroll change schedules a new one with the final state
+                return false;
+            }
+        });
+    }
