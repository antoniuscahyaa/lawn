+    /**
+     * Places the hint right after the search icon. The icon is centered inside its own view, so
+     * the hint is anchored to the icon's real right edge instead of a fixed margin, otherwise the
+     * two overlap.
+     */
+    private fun placeGlassHint() {
+        val hint = glassHint ?: return
+        val icon = mHotseatLogoIconView ?: return
+        if (hint.measuredWidth == 0) return
+        val density = resources.displayMetrics.density
+        val iconWidth = icon.drawable?.intrinsicWidth?.takeIf { it > 0 } ?: (22 * density).toInt()
+        val gap = (8 * density).toInt()
+        val iconRight = icon.left + (icon.width + iconWidth) / 2
+        val rtl = layoutDirection == LAYOUT_DIRECTION_RTL
+        if (rtl) {
+            val iconLeft = icon.left + (icon.width - iconWidth) / 2
+            val end = iconLeft - gap
+            hint.layout(end - hint.measuredWidth, hint.top, end, hint.bottom)
+        } else {
+            val start = iconRight + gap
+            hint.layout(start, hint.top, start + hint.measuredWidth, hint.bottom)
+        }
+    }
