+import com.android.launcher3.dragndrop.DragOptions;
+import com.android.launcher3.views.OptionsPopupView;
+import com.android.launcher3.views.OptionsPopupView.OptionItem;
+
+import java.util.ArrayList;
+
+/**
+ * Long press menu for workspace folders that allows switching between 1x1 and wide (2x1).
+ */
+public final class FolderResizeMenu {
+
+    private FolderResizeMenu() { }
+
+    /**
+     * Returns the drag options for a long pressed workspace item. For folders on the workspace a
+     * resize menu is shown, and dragging the folder still works as usual.
+     */
+    public static DragOptions createDragOptions(Launcher launcher, View v, ItemInfo info) {
+        DragOptions options = new DragOptions();
+        if (v instanceof FolderIcon && info instanceof FolderInfo
+                && info.container == LauncherSettings.Favorites.CONTAINER_DESKTOP) {
+            showMenu(launcher, (FolderIcon) v, (FolderInfo) info);
+            final float threshold = ViewConfiguration.get(launcher).getScaledTouchSlop() * 2f;
+            options.preDragCondition = new DragOptions.PreDragCondition() {
+                @Override
+                public boolean shouldStartDrag(double distanceDragged) {
+                    return distanceDragged > threshold;
+                }
+
+                @Override
+                public void onPreDragStart(DragObject dragObject) { }
+
+                @Override
+                public void onPreDragEnd(DragObject dragObject, boolean dragStarted) {
+                    if (dragStarted) {
+                        AbstractFloatingView.closeOpenViews(launcher, true,
+                                AbstractFloatingView.TYPE_OPTIONS_POPUP);
+                    } else {
+                        // The drag never started (finger released): show the folder again,
+                        // it was hidden when the long press began.
+                        v.setVisibility(View.VISIBLE);
+                        v.invalidate();
+                    }
+                }
+            };
+        }
+        return options;
+    }
+
+    private static void showMenu(Launcher launcher, FolderIcon icon, FolderInfo info) {
+        final boolean wide = info.spanX > 1;
+        Rect rect = new Rect();
+        launcher.getDragLayer().getDescendantRectRelativeToSelf(icon, rect);
+
+        ArrayList<OptionItem> items = new ArrayList<>();
+        items.add(new OptionItem(
+                wide ? R.string.folder_resize_normal : R.string.folder_resize_wide,
+                R.drawable.ic_widget, 0,
+                v -> {
+                    resize(launcher, icon, info, wide ? 1 : 2);
+                    return true;
+                }));
+        OptionsPopupView.show(launcher, new RectF(rect), items);
+    }
+
+    private static void resize(Launcher launcher, FolderIcon icon, FolderInfo info,
+            int newSpanX) {
+        if (!(icon.getParent() instanceof ShortcutAndWidgetContainer)
+                || !(icon.getParent().getParent() instanceof CellLayout)) {
+            return;
+        }
+        CellLayout layout = (CellLayout) icon.getParent().getParent();
+        CellLayout.LayoutParams lp = (CellLayout.LayoutParams) icon.getLayoutParams();
+        int newX = lp.cellX;
+
+        layout.markCellsAsUnoccupiedForView(icon);
+        if (newSpanX > 1) {
+            boolean right = lp.cellX + 1 < layout.getCountX()
+                    && layout.isRegionVacant(lp.cellX + 1, lp.cellY, 1, 1);
+            boolean left = !right && lp.cellX - 1 >= 0
+                    && layout.isRegionVacant(lp.cellX - 1, lp.cellY, 1, 1);
+            if (!right && !left) {
+                layout.markCellsAsOccupiedForView(icon);
+                Toast.makeText(launcher, R.string.folder_resize_no_space,
+                        Toast.LENGTH_SHORT).show();
+                return;
+            }
+            if (left) {
+                newX = lp.cellX - 1;
+            }
+        }
+
+        lp.cellX = newX;
+        lp.tmpCellX = newX;
+        lp.cellHSpan = newSpanX;
+        layout.markCellsAsOccupiedForView(icon);
+
+        launcher.getModelWriter().modifyItemInDatabase(info, info.container, info.screenId,
+                newX, lp.cellY, newSpanX, 1);
+        icon.setLayoutParams(lp);
+        layout.requestLayout();
+        icon.invalidate();
+    }
+}
