+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package com.android.launcher3.supericon;
+
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Rect;
+import android.graphics.RectF;
+
+/**
+ * Geometry of a supericon, shared by the workspace view and the editor preview so that the two
+ * match: the pill, the icon, the box the label is laid out in, and the app-shortcut chips.
+ *
+ * Shapes: a one-row pill (2x1, 3x1, 4x1) with the icon on the left and, from 3x1, round shortcut
+ * chips on the right; a card (2x2) with the icon top-left and either the label below it or, when
+ * there are shortcuts, the label beside the icon and the shortcuts as rows underneath; and a
+ * tall tile (1x2) with the icon on top and the label below.
+ */
+public final class SuperIconLayout {
+
+    public static final int MAX_CHIPS = 3;
+
+    public final RectF pill = new RectF();
+    public final Rect icon = new Rect();
+    public final RectF[] chips = {new RectF(), new RectF(), new RectF()};
+    /** How many of the chips fit (and are laid out). */
+    public int chipCountFit;
+    /** True if the chips are rows (card) rather than round buttons. */
+    public boolean chipRows;
+    public float radius;
+    public int iconSize;
+    /** Padding that defines the label's box, in view coordinates. */
+    public int padStart;
+    public int padTop;
+    public int padEnd;
+    public int padBottom;
+
+    /** The most shortcut chips a size can show. */
+    public static int maxChips(int spanX, int spanY) {
+        if (spanY == 1) {
+            return spanX >= 4 ? 3 : (spanX == 3 ? 2 : 0);
+        }
+        return spanX == 2 && spanY == 2 ? 3 : 0;
+    }
+
+    public static int iconSizeFor(int spanX, int spanY, int regularIcon) {
+        if (spanX == 1 && spanY == 2) {
+            return Math.round(regularIcon * 0.85f);
+        }
+        return spanY == 2 ? regularIcon : Math.round(regularIcon * 0.78f);
+    }
+
+    /**
+     * @param solid whether the pill has a solid fill (the icon then sits in a white ring)
+     * @param regularIcon size of a regular workspace icon, in px
+     * @param d display density
+     * @param cornerRatio 0..0.5 corner radius as a fraction of the one-row pill height
+     * @param chipCount how many shortcut chips there are to show (0 for none)
+     */
+    public void compute(int w, int h, int spanX, int spanY, boolean solid, boolean showIcon,
+            int regularIcon, float d, float cornerRatio, int chipCount) {
+        final boolean tall = spanX == 1 && spanY == 2;
+        final boolean card = spanX >= 2 && spanY == 2;
+        float side = 3 * d;
+        float rowH = h / (float) spanY;
+        float base = Math.min(rowH, regularIcon + 14 * d);
+        float vIn = (rowH - base) / 2f;
+        pill.set(side, vIn, w - side, h - vIn);
+        radius = Math.min(cornerRatio * base, Math.min(pill.width(), pill.height()) / 2f);
+        iconSize = iconSizeFor(spanX, spanY, regularIcon);
+        chipCountFit = 0;
+        chipRows = false;
+
+        if (tall) {
+            int left = (w - iconSize) / 2;
+            int top = (int) (pill.top + 12 * d);
+            icon.set(left, top, left + iconSize, top + iconSize);
+            padStart = (int) (side + 6 * d);
+            padEnd = (int) (side + 6 * d);
+            padTop = (int) (icon.bottom + (solid ? 8 : 4) * d);
+            padBottom = (int) (h - pill.bottom + 10 * d);
+            return;
+        }
+
+        if (card) {
+            float inset = 14 * d;
+            int left = (int) (pill.left + inset);
+            int top = (int) (pill.top + inset);
+            icon.set(left, top, left + iconSize, top + iconSize);
+            padEnd = (int) (11 * d);
+            if (chipCount > 0) {
+                chipRows = true;
+                padStart = showIcon ? (int) (icon.right + 10 * d) : left;
+                padTop = icon.top;
+                padBottom = h - icon.bottom;
+                float rowHt = 26 * d;
+                float gap = 5 * d;
+                float areaTop = icon.bottom + 8 * d;
+                float areaBottom = pill.bottom - 10 * d;
+                int n = 0;
+                while (n < chipCount && n < MAX_CHIPS
+                        && areaTop + (n + 1) * rowHt + n * gap <= areaBottom) {
+                    float y = areaTop + n * (rowHt + gap);
+                    chips[n].set(pill.left + inset, y, pill.right - inset, y + rowHt);
+                    n++;
+                }
+                chipCountFit = n;
+            } else {
+                padStart = left;
+                padTop = showIcon ? (int) (icon.bottom + 4 * d) : (int) (pill.top + 8 * d);
+                padBottom = (int) (h - pill.bottom + 12 * d);
+            }
+            return;
+        }
+
+        // One-row pill
+        float inset = (solid ? 12 : 9) * d;
+        int left = (int) (pill.left + inset);
+        int top = (int) (pill.top + (pill.height() - iconSize) / 2f);
+        icon.set(left, top, left + iconSize, top + iconSize);
+        float gap = (solid ? 10 : 7) * d;
+        padStart = showIcon ? (int) (icon.right + gap) : (int) (pill.left + 14 * d);
+        padTop = (int) (pill.top + 6 * d);
+        padBottom = (int) (h - pill.bottom + 6 * d);
+        padEnd = (int) (11 * d);
+        if (chipCount > 0) {
+            float cd = Math.min(30 * d, pill.height() - 12 * d);
+            float cg = 6 * d;
+            float cy = pill.centerY();
+            float right = pill.right - 9 * d;
+            int n = 0;
+            while (n < chipCount && n < MAX_CHIPS) {
+                chips[n].set(right - cd, cy - cd / 2f, right, cy + cd / 2f);
+                right -= cd + cg;
+                n++;
+            }
+            chipCountFit = n;
+            padEnd = (int) (w - (right + cg) + 6 * d);
+        }
+    }
+
+    /**
+     * Draws the pill: its fill (0 = translucent glass), then the image if there is one, then the
+     * icon's white ring for solid fills.
+     */
+    public void drawBackground(Canvas canvas, int fillColor, Bitmap image, SuperIconSettings s,
+            Paint fill, Paint stroke, float d) {
+        final boolean solid = fillColor != 0;
+        fill.setColor(solid ? fillColor : Color.argb(64, 255, 255, 255));
+        canvas.drawRoundRect(pill, radius, radius, fill);
+        if (image != null) {
+            SuperIconSettings.drawImage(canvas, image, pill, radius, s);
+        } else if (!solid) {
+            stroke.setColor(Color.argb(80, 255, 255, 255));
+            canvas.drawRoundRect(pill, radius, radius, stroke);
+        }
+        if (solid && s.showIcon) {
+            fill.setColor(Color.argb(235, 255, 255, 255));
+            canvas.drawCircle(icon.exactCenterX(), icon.exactCenterY(),
+                    icon.width() / 2f + 3 * d, fill);
+        }
+    }
+}
