+    @Override
+    public boolean onTouchEvent(MotionEvent event) {
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                mDownChip = chipAt(event.getX(), event.getY());
+                mPendingChip = -1;
+                mGestureX = event.getX();
+                mGestureY = event.getY();
+                mGestureState = 0;
+                break;
+            case MotionEvent.ACTION_MOVE:
+                if (mGestureState == 0 && (hasSwipe(true) || hasSwipe(false))) {
+                    float dx = event.getX() - mGestureX;
+                    float dy = event.getY() - mGestureY;
+                    float slop = android.view.ViewConfiguration.get(getContext())
+                            .getScaledTouchSlop() * 0.4f;
+                    if (Math.abs(dy) > slop && Math.abs(dy) > Math.abs(dx) * 1.5f
+                            && hasSwipe(dy < 0)) {
+                        // A vertical swipe: keep the launcher's own swipes (all apps, page
+                        // scrolling) from taking over this touch
+                        mGestureState = 1;
+                        if (getParent() != null) {
+                            getParent().requestDisallowInterceptTouchEvent(true);
+                        }
+                    } else if (Math.abs(dx) > slop || Math.abs(dy) > slop) {
+                        mGestureState = -1;
+                    }
+                }
+                break;
+            case MotionEvent.ACTION_UP:
+                if (mGestureState == 1) {
+                    float dy = event.getY() - mGestureY;
+                    if (Math.abs(dy) >= 32 * mDensity && hasSwipe(dy < 0)) {
+                        final boolean up = dy < 0;
+                        mPendingChip = -1;
+                        mDownChip = -1;
+                        mGestureState = 0;
+                        // End the touch as cancelled so that it is not also a click
+                        MotionEvent cancel = MotionEvent.obtain(event);
+                        cancel.setAction(MotionEvent.ACTION_CANCEL);
+                        super.onTouchEvent(cancel);
+                        cancel.recycle();
+                        runSwipe(up);
+                        return true;
+                    }
+                }
+                mGestureState = 0;
+                mPendingChip = mDownChip >= 0 && chipAt(event.getX(), event.getY()) == mDownChip
+                        ? mDownChip : -1;
+                mDownChip = -1;
+                break;
+            case MotionEvent.ACTION_CANCEL:
+                mDownChip = -1;
+                mPendingChip = -1;
+                mGestureState = 0;
+                break;
+            default:
+                break;
+        }
+        return super.onTouchEvent(event);
+    }
