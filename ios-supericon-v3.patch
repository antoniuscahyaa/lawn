+package com.android.launcher3.supericon;
+
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Rect;
+import android.graphics.RectF;
+
+/**
+ * Geometry of a supericon, shared by the workspace view and the editor preview so that the two
+ * match: the pill, the icon, and the box the label is laid out in.
+ */
+public final class SuperIconLayout {
+
+    public final RectF pill = new RectF();
+    public final Rect icon = new Rect();
+    public float radius;
+    public int iconSize;
+    /** Padding that defines the label's box, in view coordinates. */
+    public int padStart;
+    public int padTop;
+    public int padEnd;
+    public int padBottom;
+
+    /**
+     * @param card true for the 2x2 size (icon top-left, label below), false for one-row pills
+     * @param regularIcon size of a regular workspace icon, in px
+     * @param d display density
+     * @param cornerRatio 0..0.5 corner radius as a fraction of the one-row pill height
+     */
+    public void compute(int w, int h, boolean card, boolean solid, boolean showIcon,
+            int regularIcon, float d, float cornerRatio) {
+        float side = 3 * d;
+        int rows = card ? 2 : 1;
+        float rowH = h / (float) rows;
+        float base = Math.min(rowH, regularIcon + 14 * d);
+        float vIn = (rowH - base) / 2f;
+        pill.set(side, vIn, w - side, h - vIn);
+        radius = Math.min(cornerRatio * base, Math.min(pill.width(), pill.height()) / 2f);
+
+        iconSize = card ? regularIcon : Math.round(regularIcon * 0.78f);
+        float inset = (card ? 14 : (solid ? 12 : 9)) * d;
+        int left = (int) (pill.left + inset);
+        int top = card ? (int) (pill.top + inset)
+                : (int) (pill.top + (pill.height() - iconSize) / 2f);
+        icon.set(left, top, left + iconSize, top + iconSize);
+
+        padEnd = (int) (11 * d);
+        if (card) {
+            padStart = (int) (pill.left + inset);
+            padTop = showIcon ? (int) (icon.bottom + 4 * d) : (int) (pill.top + 8 * d);
+            padBottom = (int) (h - pill.bottom + 12 * d);
+        } else {
+            float gap = (solid ? 10 : 7) * d;
+            padStart = showIcon ? (int) (icon.right + gap) : (int) (pill.left + 14 * d);
+            padTop = (int) (pill.top + 6 * d);
+            padBottom = (int) (h - pill.bottom + 6 * d);
+        }
+    }
+
+    /** Draws the pill: the image if there is one, else solid or glass; then the icon's ring. */
+    public void drawBackground(Canvas canvas, boolean solid, int tint, Bitmap image,
+            SuperIconSettings s, Paint fill, Paint stroke, float d) {
+        if (image != null) {
+            SuperIconSettings.drawImage(canvas, image, pill, radius, s);
+        } else if (solid) {
+            fill.setColor(tint);
+            canvas.drawRoundRect(pill, radius, radius, fill);
+        } else {
+            fill.setColor(Color.argb(64, 255, 255, 255));
+            canvas.drawRoundRect(pill, radius, radius, fill);
+        }
+        if (!solid && image == null) {
+            stroke.setColor(Color.argb(80, 255, 255, 255));
+            canvas.drawRoundRect(pill, radius, radius, stroke);
+        }
+        if (solid && s.showIcon) {
+            fill.setColor(Color.argb(235, 255, 255, 255));
+            canvas.drawCircle(icon.exactCenterX(), icon.exactCenterY(),
+                    icon.width() / 2f + 3 * d, fill);
+        }
+    }
+}
