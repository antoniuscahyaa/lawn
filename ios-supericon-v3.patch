+                    return;
+                }
+                mShortcutBox.removeAllViews();
+                if (ids.isEmpty()) {
+                    TextView none = new TextView(this);
+                    none.setText("Aplikasi ini tidak punya pintasan.");
+                    mShortcutBox.addView(none);
+                    return;
+                }
+                TextView hint = new TextView(this);
+                hint.setText("Tanpa centang: pintasan pertama yang ditemukan dipakai.");
+                hint.setTextSize(12);
+                mShortcutBox.addView(hint);
+                mSyncing = true;
+                for (int i = 0; i < ids.size(); i++) {
+                    final String id = ids.get(i);
+                    CheckBox cb = new CheckBox(this);
+                    cb.setText(labels.get(i));
+                    cb.setChecked(mSettings.chipIds.contains(id));
+                    cb.setOnCheckedChangeListener((b, checked) -> {
+                        if (!mSyncing) {
+                            rebuildChipIds();
+                        }
+                    });
+                    mShortcutIds.add(id);
+                    mShortcutChecks.add(cb);
+                    mShortcutBox.addView(cb);
+                }
+                mSyncing = false;
+            });
+        }).start();
+    }
+
+    /** Keeps the chosen shortcut ids in the order they are listed. */
+    private void rebuildChipIds() {
+        mSettings.chipIds = new ArrayList<>();
+        for (int i = 0; i < mShortcutChecks.size(); i++) {
+            if (mShortcutChecks.get(i).isChecked()) {
+                mSettings.chipIds.add(mShortcutIds.get(i));
+            }
+        }
+    }
+
+    private String appLabel(String flat) {
+        ComponentName cn = flat == null || flat.isEmpty()
+                ? null : ComponentName.unflattenFromString(flat);
+        if (cn == null) {
+            return "Pilih aplikasi…";
+        }
+        try {
+            return "Aplikasi: " + getPackageManager().getActivityInfo(cn, 0)
+                    .loadLabel(getPackageManager());
+        } catch (Exception e) {
+            return "Aplikasi: " + cn.getPackageName();
+        }
+    }
+
+    private void refreshGestureButtons() {
+        mUpApp.setText(appLabel(mSettings.swipeUpApp));
+        mUpApp.setEnabled(mSettings.swipeUp == SuperIconSettings.GESTURE_APP);
+        mDownApp.setText(appLabel(mSettings.swipeDownApp));
+        mDownApp.setEnabled(mSettings.swipeDown == SuperIconSettings.GESTURE_APP);
+    }
+
+    /** Lets the user choose which app a swipe starts. */
+    private void pickApp(final boolean up) {
+        LauncherApps apps = (LauncherApps) getSystemService(Context.LAUNCHER_APPS_SERVICE);
+        final List<LauncherActivityInfo> list = new ArrayList<>(
+                apps.getActivityList(null, android.os.Process.myUserHandle()));
+        Collections.sort(list, (a, b) -> a.getLabel().toString()
+                .compareToIgnoreCase(b.getLabel().toString()));
+        CharSequence[] labels = new CharSequence[list.size()];
+        for (int i = 0; i < labels.length; i++) {
+            labels[i] = list.get(i).getLabel();
+        }
+        new AlertDialog.Builder(this)
+                .setTitle("Pilih aplikasi")
+                .setItems(labels, (dialog, which) -> {
+                    String flat = list.get(which).getComponentName().flattenToString();
+                    if (up) {
+                        mSettings.swipeUpApp = flat;
+                    } else {
+                        mSettings.swipeDownApp = flat;
+                    }
+                    refreshGestureButtons();
+                })
+                .show();
+    }
+
+    /** Sets the image sliders from the settings (after a gesture on the preview). */
+    private void syncImageControls() {
+        setSeek(mZoom, Math.round(mSettings.imageZoom * 100));
+        setSeek(mPanX, Math.round(mSettings.imageX * 100) + 100);
+        setSeek(mPanY, Math.round(mSettings.imageY * 100) + 100);
+    }
+
+    private void applyPreset(int preset) {
+        switch (preset) {
+            case 0: // Kaca
+                mSolidStyle = false;
+                mSettings.bgMode = SuperIconSettings.BG_STYLE;
+                mSettings.glassAlpha = 25;
+                mSettings.glassShine = true;
+                mSettings.showLabel = true;
+                mSettings.showIcon = true;
+                mSettings.labelColor = 0;
+                break;
+            case 1: // Warna
+                mSolidStyle = true;
+                mSettings.bgMode = SuperIconSettings.BG_ADAPTIVE;
+                mSettings.iconRing = true;
+                mSettings.showLabel = true;
+                mSettings.showIcon = true;
+                mSettings.labelColor = 0;
+                break;
+            case 2: // Foto gelap
+                mSettings.imageZoom = 1f;
+                mSettings.imageX = 0f;
+                mSettings.imageY = 0f;
+                mSettings.imageDim = 55;
+                mSettings.showLabel = true;
+                mSettings.labelColor = 0;
+                if (mPreview.image == null) {
+                    Toast.makeText(this, "Pilih gambar dulu agar preset ini terlihat",
+                            Toast.LENGTH_SHORT).show();
+                }
+                break;
+            default: // Minimal
+                mSettings.showLabel = false;
+                mSettings.showChips = false;
+                mSettings.subtitleMode = SuperIconSettings.SUB_NONE;
+                break;
+        }
+        mPreview.solidStyle = mSolidStyle;
+        syncControls();
+    }
+
+    private void copyStyle() {
+        File image = null;
+        if (mPending != null && mPending.exists()) {
+            image = mPending;
+        } else if (!mRemoveImage) {
+            File f = SuperIconSettings.imageFile(this, mId);
+            image = f.exists() ? f : null;
+        }
+        SuperIconSettings.saveClip(this, mSettings, mSolidStyle, image);
+        Toast.makeText(this, "Gaya disalin", Toast.LENGTH_SHORT).show();
+    }
+
+    private void pasteStyle() {
+        SuperIconSettings.Clip clip = SuperIconSettings.loadClip(this);
+        if (clip == null) {
+            Toast.makeText(this, "Belum ada gaya yang disalin", Toast.LENGTH_SHORT).show();
+            return;
+        }
+        // The subtitle and the chosen shortcuts belong to the app, so they are kept
+        SuperIconSettings pasted = clip.settings;
+        pasted.subtitleMode = mSettings.subtitleMode;
+        pasted.subtitleText = mSettings.subtitleText;
+        pasted.chipIds = mSettings.chipIds;
+        mSettings = pasted;
+        mSolidStyle = clip.solid;
+        mPreview.solidStyle = mSolidStyle;
+        if (mPending != null) {
+            mPending.delete();
+            mPending = null;
+        }
+        if (clip.image != null) {
+            File temp = SuperIconSettings.tempImageFile(this, mId);
+            if (SuperIconSettings.copyFile(clip.image, temp)) {
+                mPending = temp;
+                mRemoveImage = false;
+                mPreview.image = BitmapFactory.decodeFile(temp.getAbsolutePath());
+            }
+        } else {
+            mPreview.image = null;
+            mRemoveImage = true;
+        }
+        syncControls();
+    }
