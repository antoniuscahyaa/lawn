+
+    private CheckBox check(LinearLayout parent, String text, OnBool cb) {
+        CheckBox c = new CheckBox(this);
+        c.setText(text);
+        c.setOnCheckedChangeListener((b, checked) -> {
+            if (!mSyncing) {
+                cb.on(checked);
+                mPreview.invalidate();
+            }
+        });
+        parent.addView(c);
+        return c;
+    }
+
+    private RadioGroup radios(String[] labels, boolean horizontal, OnValue cb) {
+        RadioGroup g = new RadioGroup(this);
+        g.setOrientation(horizontal ? RadioGroup.HORIZONTAL : RadioGroup.VERTICAL);
+        for (String label : labels) {
+            RadioButton b = new RadioButton(this);
+            b.setText(label);
+            b.setId(View.generateViewId());
+            g.addView(b);
+        }
+        g.setOnCheckedChangeListener((group, id) -> {
+            if (mSyncing) {
+                return;
+            }
+            for (int i = 0; i < group.getChildCount(); i++) {
+                if (group.getChildAt(i).getId() == id) {
+                    cb.on(i);
+                }
+            }
+        });
+        return g;
+    }
+
+    private static void checkIndex(RadioGroup g, int index) {
+        g.check(g.getChildAt(index).getId());
+    }
+
+    private SeekBar seek(LinearLayout parent, String label, int min, int max, OnValue cb) {
+        TextView t = new TextView(this);
+        t.setText(label);
+        parent.addView(t);
+        SeekBar s = new SeekBar(this);
+        s.setMax(max - min);
+        s.setTag(min);
+        s.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
+            @Override
+            public void onProgressChanged(SeekBar bar, int progress, boolean fromUser) {
+                if (fromUser) {
+                    cb.on(progress + min);
+                }
+            }
+
+            @Override
+            public void onStartTrackingTouch(SeekBar bar) { }
+
+            @Override
+            public void onStopTrackingTouch(SeekBar bar) { }
+        });
+        parent.addView(s);
+        return s;
+    }
+
+    private static void setSeek(SeekBar bar, int value) {
+        bar.setProgress(value - (Integer) bar.getTag());
+    }
+
+    private static int sizeIndex(int sx, int sy) {
+        for (int i = 0; i < SIZES.length; i++) {
+            if (SIZES[i][0] == sx && SIZES[i][1] == sy) {
+                return i;
+            }
+        }
+        return 0;
+    }
+
+    /** Pushes the current settings into the controls. */
+    private void syncControls() {
+        mSyncing = true;
+        checkIndex(mSizeGroup, sizeIndex(mPreview.sx, mPreview.sy));
+        checkIndex(mStyleGroup, mSolidStyle ? 1 : 0);
+        checkIndex(mBgGroup, mSettings.bgMode);
+        mHex.setEnabled(mSettings.bgMode == SuperIconSettings.BG_CUSTOM);
+        mHex.setText(hex(mSettings.bgColor));
+        setSeek(mZoom, Math.round(mSettings.imageZoom * 100));
+        setSeek(mPanX, Math.round(mSettings.imageX * 100) + 100);
+        setSeek(mPanY, Math.round(mSettings.imageY * 100) + 100);
+        setSeek(mDim, mSettings.imageDim);
+        setSeek(mLabelSize, Math.round(mSettings.labelScale * 100));
+        mShowIcon.setChecked(mSettings.showIcon);
+        mShowLabel.setChecked(mSettings.showLabel);
+        mShowChips.setChecked(mSettings.showChips);
+        mIconBg.setChecked(mSettings.iconBackground);
+        checkIndex(mUpGroup, mSettings.swipeUp);
+        checkIndex(mDownGroup, mSettings.swipeDown);
+        mShowDot.setChecked(mSettings.showDot);
+        mPopupExtras.setChecked(mSettings.popupExtras);
+        setSeek(mGlassAlpha, mSettings.glassAlpha);
+        mShine.setChecked(mSettings.glassShine);
+        setSeek(mIconScale, Math.round(mSettings.iconScale * 100));
+        mRing.setChecked(mSettings.iconRing);
+        checkIndex(mSubGroup, mSettings.subtitleMode);
+        mSubText.setEnabled(mSettings.subtitleMode == SuperIconSettings.SUB_TEXT);
+        mSubText.setText(mSettings.subtitleText);
+        for (int i = 0; i < mShortcutChecks.size(); i++) {
+            mShortcutChecks.get(i).setChecked(mSettings.chipIds.contains(mShortcutIds.get(i)));
+        }
+        mSyncing = false;
+        refreshGestureButtons();
+        refreshSwatches();
+        refreshGrid();
+        mPreview.settings = mSettings;
+        mPreview.requestLayout();
+        mPreview.invalidate();
+    }
+
+    private static String hex(int color) {
+        return (color >>> 24) == 0xFF
+                ? String.format("#%06X", color & 0xFFFFFF) : String.format("#%08X", color);
+    }
+
+    private void refreshSwatches() {
+        for (int i = 0; i < SWATCHES.length; i++) {
+            GradientDrawable g = new GradientDrawable();
+            g.setShape(GradientDrawable.OVAL);
+            g.setColor(SWATCHES[i] == 0 ? 0xFFDDDDDD : SWATCHES[i]);
+            boolean on = SWATCHES[i] == mSettings.labelColor;
+            g.setStroke((int) ((on ? 3 : 1) * mD), on ? 0xFF1A73E8 : 0xFF888888);
+            mSwatchViews[i].setBackground(g);
+        }
+    }
+
+    private void refreshGrid() {
+        int h = mSettings.effectiveH(mPreview.sx, mPreview.sy);
+        int v = mSettings.effectiveV(mPreview.sx, mPreview.sy, mPreview.chipCount());
+        for (int r = 0; r < 3; r++) {
+            for (int c = 0; c < 3; c++) {
+                mGrid[r * 3 + c].setText(r == v && c == h ? "●" : "○");
+            }
+        }
+    }
