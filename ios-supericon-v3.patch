+
+    // ------------------------------------------------------------ UI helpers
+
+    private interface OnBool {
+        void on(boolean value);
+    }
+
+    private LinearLayout row() {
+        LinearLayout l = new LinearLayout(this);
+        l.setOrientation(LinearLayout.HORIZONTAL);
+        return l;
+    }
+
+    private LinearLayout.LayoutParams weight() {
+        return new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f);
+    }
+
+    private Button button(String text, View.OnClickListener l) {
+        Button b = new Button(this);
+        b.setText(text);
+        b.setAllCaps(false);
+        b.setOnClickListener(l);
+        return b;
+    }
+
+    private TextView section(String text) {
+        TextView t = new TextView(this);
+        t.setText(text);
+        t.setTextSize(16);
+        t.setPadding(0, (int) (16 * mD), 0, (int) (4 * mD));
+        return t;
+    }
+
+    private CheckBox check(LinearLayout parent, String text, OnBool cb) {
+        CheckBox c = new CheckBox(this);
+        c.setText(text);
+        c.setOnCheckedChangeListener((b, checked) -> {
+            if (!mSyncing) {
+                cb.on(checked);
+                mPreview.invalidate();
+            }
+        });
+        parent.addView(c);
+        return c;
+    }
+
+    private RadioGroup radios(String[] labels, boolean horizontal, OnValue cb) {
+        RadioGroup g = new RadioGroup(this);
+        g.setOrientation(horizontal ? RadioGroup.HORIZONTAL : RadioGroup.VERTICAL);
+        for (String label : labels) {
+            RadioButton b = new RadioButton(this);
+            b.setText(label);
+            b.setId(View.generateViewId());
+            g.addView(b);
+        }
+        g.setOnCheckedChangeListener((group, id) -> {
+            if (mSyncing) {
+                return;
+            }
+            for (int i = 0; i < group.getChildCount(); i++) {
+                if (group.getChildAt(i).getId() == id) {
+                    cb.on(i);
+                }
+            }
+        });
+        return g;
+    }
+
+    private static void checkIndex(RadioGroup g, int index) {
+        g.check(g.getChildAt(index).getId());
+    }
+
+    private SeekBar seek(LinearLayout parent, String label, int min, int max, OnValue cb) {
+        TextView t = new TextView(this);
+        t.setText(label);
+        parent.addView(t);
+        SeekBar s = new SeekBar(this);
+        s.setMax(max - min);
+        s.setTag(min);
+        s.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
+            @Override
+            public void onProgressChanged(SeekBar bar, int progress, boolean fromUser) {
+                if (fromUser) {
+                    cb.on(progress + min);
+                }
+            }
+
+            @Override
+            public void onStartTrackingTouch(SeekBar bar) { }
+
+            @Override
+            public void onStopTrackingTouch(SeekBar bar) { }
+        });
+        parent.addView(s);
+        return s;
+    }
+
+    private static void setSeek(SeekBar bar, int value) {
+        bar.setProgress(value - (Integer) bar.getTag());
+    }
+
+    private static int sizeIndex(int sx, int sy) {
+        for (int i = 0; i < SIZES.length; i++) {
+            if (SIZES[i][0] == sx && SIZES[i][1] == sy) {
+                return i;
+            }
+        }
+        return 0;
+    }
+
+    /** Pushes the current settings into the controls. */
+    private void syncControls() {
+        mSyncing = true;
+        checkIndex(mSizeGroup, sizeIndex(mPreview.sx, mPreview.sy));
+        checkIndex(mStyleGroup, mSolidStyle ? 1 : 0);
+        checkIndex(mBgGroup, mSettings.bgMode);
+        mHex.setEnabled(mSettings.bgMode == SuperIconSettings.BG_CUSTOM);
+        mHex.setText(hex(mSettings.bgColor));
+        setSeek(mZoom, Math.round(mSettings.imageZoom * 100));
+        setSeek(mPanX, Math.round(mSettings.imageX * 100) + 100);
+        setSeek(mPanY, Math.round(mSettings.imageY * 100) + 100);
+        setSeek(mDim, mSettings.imageDim);
+        setSeek(mLabelSize, Math.round(mSettings.labelScale * 100));
+        mShowIcon.setChecked(mSettings.showIcon);
+        mShowLabel.setChecked(mSettings.showLabel);
+        mShowChips.setChecked(mSettings.showChips);
+        mSyncing = false;
+        refreshSwatches();
+        refreshGrid();
+        mPreview.settings = mSettings;
+        mPreview.requestLayout();
+        mPreview.invalidate();
+    }
+
+    private static String hex(int color) {
+        return (color >>> 24) == 0xFF
+                ? String.format("#%06X", color & 0xFFFFFF) : String.format("#%08X", color);
+    }
+
+    private void refreshSwatches() {
+        for (int i = 0; i < SWATCHES.length; i++) {
+            GradientDrawable g = new GradientDrawable();
+            g.setShape(GradientDrawable.OVAL);
+            g.setColor(SWATCHES[i] == 0 ? 0xFFDDDDDD : SWATCHES[i]);
+            boolean on = SWATCHES[i] == mSettings.labelColor;
+            g.setStroke((int) ((on ? 3 : 1) * mD), on ? 0xFF1A73E8 : 0xFF888888);
+            mSwatchViews[i].setBackground(g);
+        }
+    }
+
+    private void refreshGrid() {
+        int h = mSettings.effectiveH(mPreview.sx, mPreview.sy);
+        int v = mSettings.effectiveV(mPreview.sx, mPreview.sy, mPreview.chipCount());
+        for (int r = 0; r < 3; r++) {
+            for (int c = 0; c < 3; c++) {
+                mGrid[r * 3 + c].setText(r == v && c == h ? "●" : "○");
+            }
+        }
+    }
+
+    // --------------------------------------------------------------- actions
+
+    private void pickImage() {
+        Intent i = new Intent(Intent.ACTION_GET_CONTENT);
+        i.setType("image/*");
+        i.addCategory(Intent.CATEGORY_OPENABLE);
+        try {
+            startActivityForResult(i, REQ_PICK);
+        } catch (RuntimeException e) {
+            Toast.makeText(this, "Tidak ada aplikasi untuk memilih gambar", Toast.LENGTH_SHORT)
+                    .show();
+        }
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (requestCode != REQ_PICK || resultCode != RESULT_OK || data == null
+                || data.getData() == null) {
+            return;
+        }
+        final Context ctx = getApplicationContext();
+        final File dest = SuperIconSettings.tempImageFile(ctx, mId);
+        final Uri uri = data.getData();
+        new Thread(() -> {
+            final boolean ok = SuperIconSettings.importImage(ctx, uri, dest);
+            runOnUiThread(() -> {
+                if (isFinishing()) {
+                    return;
+                }
+                Bitmap b = ok ? BitmapFactory.decodeFile(dest.getAbsolutePath()) : null;
+                if (b == null) {
+                    Toast.makeText(this, "Gambar tidak bisa dibuka", Toast.LENGTH_SHORT).show();
+                    return;
+                }
+                mPending = dest;
+                mRemoveImage = false;
+                mPreview.image = b;
+                mPreview.invalidate();
+            });
+        }).start();
+    }
+
+    private void resetAll() {
+        mSettings = new SuperIconSettings();
+        mPreview.image = null;
+        mRemoveImage = true;
+        if (mPending != null) {
+            mPending.delete();
+            mPending = null;
+        }
+        syncControls();
+    }
+
+    private void cancel() {
+        SuperIconSettings.tempImageFile(this, mId).delete();
+        finish();
+    }
+
+    private void save() {
+        File fin = SuperIconSettings.imageFile(this, mId);
+        if (mRemoveImage) {
+            fin.delete();
+            mRemoveImage = false;
+        }
+        if (mPending != null && mPending.exists()) {
+            fin.delete();
+            if (!mPending.renameTo(fin)) {
+                Toast.makeText(this, "Gambar gagal disimpan", Toast.LENGTH_SHORT).show();
+            }
+            mPending = null;
+        }
+        mSettings.save(this, mId);
+
+        boolean resized = mPreview.sx != mOrigSx || mPreview.sy != mOrigSy
+                || mSolidStyle != mOrigSolid;
+        if (resized) {
+            String error = SuperIconMenu.resizeFromEditor((int) mId,
+                    mSolidStyle ? WorkspaceItemInfo.SUPER_STYLE_SOLID
+                            : WorkspaceItemInfo.SUPER_STYLE_SIDE,
+                    mPreview.sx, mPreview.sy);
+            if (error != null) {
+                // Stay open so another size can be chosen; the other settings are saved
+                Toast.makeText(this, error, Toast.LENGTH_LONG).show();
+                SuperIconSettings.notifyChanged(mId);
+                return;
+            }
+            mOrigSx = mPreview.sx;
+            mOrigSy = mPreview.sy;
+            mOrigSolid = mSolidStyle;
+        }
+        SuperIconSettings.notifyChanged(mId);
+        finish();
+    }
+
+    @Override
+    protected void onDestroy() {
+        super.onDestroy();
+        if (mId >= 0 && !isChangingConfigurations()) {
+            SuperIconSettings.tempImageFile(this, mId).delete();
+        }
+    }
+
+    // --------------------------------------------------------------- preview
+
+    /** Draws a supericon at the size of the real view, scaled to the width available. */
+    private static class Preview extends View {
+        final SuperIconLayout lay = new SuperIconLayout();
+        final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+        final Paint stroke = new Paint(Paint.ANTI_ALIAS_FLAG);
+        final Paint backPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        final TextPaint text = new TextPaint(Paint.ANTI_ALIAS_FLAG);
+        final RectF tmp = new RectF();
+        final float d;
+        SuperIconSettings settings;
+        Bitmap image;
+        Bitmap icon;
+        String label = "";
+        boolean solidStyle;
+        int sx = 2;
+        int sy = 1;
+        int cellW = 1;
+        int cellH = 1;
+        int tint;
+        int defColor;
+        int regular;
+        float baseText;
+        float ratio = 0.5f;
+
+        Preview(Context c) {
+            super(c);
+            d = c.getResources().getDisplayMetrics().density;
+            stroke.setStyle(Paint.Style.STROKE);
+            stroke.setStrokeWidth(d);
+            backPaint.setColor(0xFF6B6F76);
+        }
+
+        int chipCount() {
+            return settings != null && settings.showChips
+                    ? SuperIconLayout.maxChips(sx, sy) : 0;
+        }
+
+        @Override
+        protected void onMeasure(int wSpec, int hSpec) {
+            int w = MeasureSpec.getSize(wSpec);
+            // A one-column tile is narrow: show it at no more than the width of its own size
+            // relative to a 2-wide pill so it does not fill the screen.
+            int vw = cellW * sx;
+            int vh = cellH * sy;
+            float k = Math.min(w / (float) vw, (w * 0.5f) / (float) cellW);
+            setMeasuredDimension(w, Math.round(vh * k) + 1);
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            int vw = cellW * sx;
+            int vh = cellH * sy;
+            float k = Math.min(getWidth() / (float) vw, (getWidth() * 0.5f) / (float) cellW);
+            canvas.drawRoundRect(0, 0, getWidth(), getHeight(), 16 * d, 16 * d, backPaint);
+            canvas.save();
+            canvas.translate((getWidth() - vw * k) / 2f, 0);
+            canvas.scale(k, k);
+            int chips = chipCount();
+            int fillColor = settings.fillColor(solidStyle, tint);
+            lay.compute(vw, vh, sx, sy, fillColor != 0, settings.showIcon, regular, d, ratio,
+                    chips);
+            lay.drawBackground(canvas, fillColor, image, settings, fill, stroke, d);
+            if (settings.showIcon && icon != null) {
+                canvas.drawBitmap(icon, null, lay.icon, null);
+            }
+            int labelColor = settings.resolveLabelColor(fillColor, image != null, defColor);
+
+            // Placeholders where the app's shortcuts go
+            for (int i = 0; i < lay.chipCountFit; i++) {
+                RectF r = lay.chips[i];
+                if (lay.chipRows) {
+                    fill.setColor(Color.argb(60, 255, 255, 255));
+                    canvas.drawRoundRect(r, r.height() / 2f, r.height() / 2f, fill);
+                    text.setTextSize(baseText * 0.9f);
+                    text.setColor(labelColor);
+                    Paint.FontMetrics fm = text.getFontMetrics();
+                    canvas.drawText("Pintasan " + (i + 1), r.left + 12 * d,
+                            r.centerY() - (fm.ascent + fm.descent) / 2f, text);
+                } else {
+                    fill.setColor(Color.argb(235, 255, 255, 255));
+                    canvas.drawCircle(r.centerX(), r.centerY(), r.width() / 2f, fill);
+                    fill.setColor(0xFF9AA0A6);
+                    canvas.drawCircle(r.centerX(), r.centerY(), r.width() / 5f, fill);
+                }
+            }
+
+            if (settings.showLabel) {
+                text.setTextSize(baseText * settings.labelScale);
+                text.setColor(labelColor);
+                int boxW = Math.max(1, vw - lay.padStart - lay.padEnd);
+                int h = settings.effectiveH(sx, sy);
+                int v = settings.effectiveV(sx, sy, chips);
+                Layout.Alignment align = h == 0 ? Layout.Alignment.ALIGN_NORMAL
+                        : (h == 1 ? Layout.Alignment.ALIGN_CENTER
+                        : Layout.Alignment.ALIGN_OPPOSITE);
+                String shown = label;
+                StaticLayout sl = new StaticLayout(shown, text, boxW, align, 1f, 0f, false);
+                if (sl.getLineCount() > 2) {
+                    int end = Math.max(1, sl.getLineEnd(1) - 1);
+                    shown = label.substring(0, Math.min(end, label.length())).trim() + "…";
+                    sl = new StaticLayout(shown, text, boxW, align, 1f, 0f, false);
+                }
+                float boxH = vh - lay.padTop - lay.padBottom;
+                float y = lay.padTop + (v == 0 ? 0 : (v == 1 ? (boxH - sl.getHeight()) / 2f
+                        : boxH - sl.getHeight()));
+                canvas.translate(lay.padStart, y);
+                sl.draw(canvas);
+            }
+            canvas.restore();
+        }
+    }
+}
