+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package com.android.launcher3.supericon;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+import android.net.Uri;
+import android.util.LruCache;
+
+import androidx.core.graphics.ColorUtils;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+import java.util.WeakHashMap;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Per-supericon customisation: background colour and image (zoom in or out, pan, dimming), label
+ * colour, size and position, and what is shown (icon, label, app shortcuts). Stored in
+ * SharedPreferences (one JSON string per item id); the background image is a PNG in the app's
+ * files directory.
+ */
+public final class SuperIconSettings {
+
+    private static final String PREFS = "supericon_settings";
+    private static final int MAX_IMAGE_SIDE = 1024;
+
+    public static final int BG_STYLE = 0;
+    public static final int BG_ADAPTIVE = 1;
+    public static final int BG_CUSTOM = 2;
+
+    public static final float MIN_ZOOM = 0.3f;
+    public static final float MAX_ZOOM = 3f;
+
+    /** Background image zoom: below 1 the image is smaller than the pill, above 1 it is cropped. */
+    public float imageZoom = 1f;
+    /** Background image pan, -1..1. */
+    public float imageX = 0f;
+    public float imageY = 0f;
+    /** Darkening on top of the image, 0..80 percent. */
+    public int imageDim = 35;
+    /** Background: {@link #BG_STYLE} (from the style), {@link #BG_ADAPTIVE} (the icon's colour)
+     *  or {@link #BG_CUSTOM} ({@link #bgColor}). */
+    public int bgMode = BG_STYLE;
+    public int bgColor = 0xFF2D2D2D;
+    /** Label colour, or 0 for automatic. */
+    public int labelColor = 0;
+    /** Label size multiplier, 0.5..1.6. */
+    public float labelScale = 1f;
+    /** Label position: 0..2 horizontally (start, centre, end) and vertically (top, centre,
+     *  bottom), or -1 for the default of the current size. */
+    public int labelH = -1;
+    public int labelV = -1;
+    public boolean showIcon = true;
+    public boolean showLabel = true;
+    public boolean showChips = true;
+
+    public interface Listener {
+        void onSuperIconSettingsChanged(long itemId);
+    }
+
+    private static final Set<Listener> sListeners =
+            Collections.newSetFromMap(new WeakHashMap<Listener, Boolean>());
+    private static final LruCache<String, Bitmap> sImages = new LruCache<>(6);
+    /** Supericons currently on the workspace: item id to the app's component name. */
+    private static final Map<Long, String> sActive = new ConcurrentHashMap<>();
+
+    private static final Paint sImagePaint =
+            new Paint(Paint.ANTI_ALIAS_FLAG | Paint.FILTER_BITMAP_FLAG);
+    private static final Paint sDimPaint = new Paint();
+    private static final Path sClip = new Path();
+    private static final RectF sDst = new RectF();
+
+    // ------------------------------------------------------------ resolution
+
+    public static int defaultH(int spanX, int spanY) {
+        return spanX == 1 && spanY == 2 ? 1 : 0;
+    }
+
+    public static int defaultV(int spanX, int spanY, int chipCount) {
+        if (spanY == 2 && spanX >= 2) {
+            return chipCount > 0 ? 1 : 2;
+        }
+        return spanY == 2 ? 2 : 1;
+    }
+
+    public int effectiveH(int spanX, int spanY) {
+        return labelH >= 0 ? labelH : defaultH(spanX, spanY);
+    }
+
+    public int effectiveV(int spanX, int spanY, int chipCount) {
+        return labelV >= 0 ? labelV : defaultV(spanX, spanY, chipCount);
+    }
+
+    /** The pill's fill colour, or 0 for the translucent glass look. */
+    public int fillColor(boolean solidStyle, int tint) {
+        if (bgMode == BG_CUSTOM) {
+            return (bgColor >>> 24) == 0 ? (bgColor | 0xFF000000) : bgColor;
+        }
+        if (bgMode == BG_ADAPTIVE) {
+            return tint;
+        }
+        return solidStyle ? tint : 0;
+    }
+
+    /** The label colour to use; {@code defaultColor} applies only over the plain glass look. */
+    public int resolveLabelColor(int fill, boolean hasImage, int defaultColor) {
+        if (labelColor != 0) {
+            return labelColor;
+        }
+        if (hasImage && imageZoom >= 1f) {
+            return Color.WHITE;
+        }
+        if (fill != 0) {
+            return ColorUtils.calculateLuminance(fill | 0xFF000000) > 0.55
+                    ? Color.argb(230, 20, 20, 20) : Color.WHITE;
+        }
+        return defaultColor;
+    }
+
+    // --------------------------------------------------------------- storage
+
+    public JSONObject toJson() throws JSONException {
+        JSONObject o = new JSONObject();
+        o.put("zoom", imageZoom);
+        o.put("x", imageX);
+        o.put("y", imageY);
+        o.put("dim", imageDim);
+        o.put("bgMode", bgMode);
+        o.put("bgColor", bgColor);
+        o.put("color", labelColor);
+        o.put("scale", labelScale);
+        o.put("h", labelH);
+        o.put("v", labelV);
+        o.put("icon", showIcon);
+        o.put("label", showLabel);
+        o.put("chips", showChips);
+        return o;
+    }
+
+    public static SuperIconSettings fromJson(JSONObject o) {
+        SuperIconSettings s = new SuperIconSettings();
+        s.imageZoom = clamp((float) o.optDouble("zoom", 1), MIN_ZOOM, MAX_ZOOM);
+        s.imageX = clamp((float) o.optDouble("x", 0), -1f, 1f);
+        s.imageY = clamp((float) o.optDouble("y", 0), -1f, 1f);
+        s.imageDim = Math.max(0, Math.min(80, o.optInt("dim", 35)));
+        s.bgMode = Math.max(0, Math.min(2, o.optInt("bgMode", BG_STYLE)));
+        s.bgColor = o.optInt("bgColor", 0xFF2D2D2D);
+        s.labelColor = o.optInt("color", 0);
+        s.labelScale = clamp((float) o.optDouble("scale", 1), 0.5f, 1.6f);
+        s.labelH = Math.max(-1, Math.min(2, o.optInt("h", -1)));
+        s.labelV = Math.max(-1, Math.min(2, o.optInt("v", -1)));
+        s.showIcon = o.optBoolean("icon", true);
+        s.showLabel = o.optBoolean("label", true);
+        s.showChips = o.optBoolean("chips", true);
+        return s;
+    }
+
+    public static SuperIconSettings load(Context context, long id) {
+        String json = prefs(context).getString(key(id), null);
+        if (json == null) {
+            return new SuperIconSettings();
+        }
+        try {
+            return fromJson(new JSONObject(json));
+        } catch (JSONException e) {
+            return new SuperIconSettings();
+        }
+    }
+
+    public void save(Context context, long id) {
+        try {
+            prefs(context).edit().putString(key(id), toJson().toString()).apply();
+        } catch (JSONException e) {
+            // Nothing sensible to do; the previous settings stay in place
+        }
+    }
+
+    /** Whether anything (settings or an image) is stored for the item. */
+    public static boolean hasStored(Context context, long id) {
+        return prefs(context).contains(key(id)) || imageFile(context, id).exists();
+    }
+
+    public static void delete(Context context, long id) {
+        prefs(context).edit().remove(key(id)).apply();
+        imageFile(context, id).delete();
+        tempImageFile(context, id).delete();
+    }
+
+    /**
+     * Deletes the stored settings and images of items that are not in {@code keep}. Returns how
+     * many items were removed.
+     */
+    public static int deleteExcept(Context context, Set<Long> keep) {
+        Set<Long> removed = new HashSet<>();
+        SharedPreferences p = prefs(context);
+        SharedPreferences.Editor ed = p.edit();
+        for (String k : p.getAll().keySet()) {
+            if (!k.startsWith("s_")) {
+                continue;
+            }
+            try {
+                long id = Long.parseLong(k.substring(2));
+                if (!keep.contains(id)) {
+                    ed.remove(k);
+                    removed.add(id);
+                }
+            } catch (NumberFormatException e) {
+                // Not one of ours
+            }
+        }
+        ed.apply();
+        File[] files = dir(context).listFiles();
+        if (files != null) {
+            for (File f : files) {
+                String name = f.getName();
+                int dot = name.indexOf('.');
+                if (dot <= 0) {
+                    continue;
+                }
+                try {
+                    long id = Long.parseLong(name.substring(0, dot));
+                    if (!keep.contains(id)) {
+                        f.delete();
+                        removed.add(id);
+                    }
+                } catch (NumberFormatException e) {
+                    // Not one of ours
+                }
+            }
+        }
+        return removed.size();
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getApplicationContext().getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    private static String key(long id) {
+        return "s_" + id;
+    }
+
+    // -------------------------------------------------------- active supericons
+
+    public static void setActive(long id, String component) {
+        if (component != null && !component.isEmpty()) {
+            sActive.put(id, component);
+        }
+    }
+
+    public static void removeActive(long id) {
+        sActive.remove(id);
+    }
+
+    public static Map<Long, String> activeItems() {
+        return new java.util.HashMap<>(sActive);
+    }
+
+    // ---------------------------------------------------------------- images
+
+    private static File dir(Context context) {
+        File d = new File(context.getFilesDir(), "supericon");
+        if (!d.exists()) {
+            d.mkdirs();
+        }
+        return d;
+    }
+
+    public static File imageFile(Context context, long id) {
+        return new File(dir(context), id + ".png");
+    }
+
+    public static File tempImageFile(Context context, long id) {
+        return new File(dir(context), id + ".tmp.png");
+    }
+
+    /** The saved background image of an item, or null. */
+    public static Bitmap loadImage(Context context, long id) {
+        return decodeCached(imageFile(context, id));
+    }
+
+    public static Bitmap decodeCached(File f) {
+        if (f == null || !f.exists()) {
+            return null;
+        }
+        String k = f.getAbsolutePath() + "@" + f.lastModified() + "/" + f.length();
+        Bitmap b = sImages.get(k);
+        if (b == null) {
+            b = BitmapFactory.decodeFile(f.getAbsolutePath());
+            if (b != null) {
+                sImages.put(k, b);
+            }
+        }
+        return b;
+    }
+
+    /** Decodes the picked image at a reduced size and writes it to {@code dest} as a PNG. */
+    public static boolean importImage(Context context, Uri uri, File dest) {
+        try {
+            BitmapFactory.Options o = new BitmapFactory.Options();
+            o.inJustDecodeBounds = true;
+            try (InputStream in = context.getContentResolver().openInputStream(uri)) {
+                BitmapFactory.decodeStream(in, null, o);
+            }
+            int sample = 1;
+            int longest = Math.max(o.outWidth, o.outHeight);
+            while (longest / sample > MAX_IMAGE_SIDE * 2) {
+                sample *= 2;
+            }
+            o = new BitmapFactory.Options();
+            o.inSampleSize = sample;
+            Bitmap bmp;
+            try (InputStream in = context.getContentResolver().openInputStream(uri)) {
+                bmp = BitmapFactory.decodeStream(in, null, o);
+            }
+            if (bmp == null) {
+                return false;
+            }
+            int side = Math.max(bmp.getWidth(), bmp.getHeight());
+            if (side > MAX_IMAGE_SIDE) {
+                float f = MAX_IMAGE_SIDE / (float) side;
+                bmp = Bitmap.createScaledBitmap(bmp, Math.max(1, Math.round(bmp.getWidth() * f)),
+                        Math.max(1, Math.round(bmp.getHeight() * f)), true);
+            }
+            dest.getParentFile().mkdirs();
+            try (FileOutputStream out = new FileOutputStream(dest)) {
+                bmp.compress(Bitmap.CompressFormat.PNG, 100, out);
+            }
+            return true;
+        } catch (IOException | RuntimeException | OutOfMemoryError e) {
+            return false;
+        }
+    }
+
+    /**
+     * Draws the image inside the rounded pill. At zoom 1 it just covers the pill; above that it
+     * is cropped, below it the image is smaller than the pill and the background shows around it.
+     */
+    public static void drawImage(Canvas canvas, Bitmap bmp, RectF pill, float radius,
+            SuperIconSettings s) {
+        float bw = bmp.getWidth();
+        float bh = bmp.getHeight();
+        float scale = Math.max(pill.width() / bw, pill.height() / bh) * s.imageZoom;
+        float sw = bw * scale;
+        float sh = bh * scale;
+        float rangeX = Math.abs(sw - pill.width()) / 2f;
+        float rangeY = Math.abs(sh - pill.height()) / 2f;
+        float left = pill.centerX() - sw / 2f + s.imageX * rangeX;
