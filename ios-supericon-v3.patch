+    // --------------------------------------------------------------- preview
+
+    /** Draws a supericon at the size of the real view, scaled to the width available. */
+    private static class Preview extends View {
+        final SuperIconLayout lay = new SuperIconLayout();
+        final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+        final Paint stroke = new Paint(Paint.ANTI_ALIAS_FLAG);
+        final Paint backPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        final TextPaint text = new TextPaint(Paint.ANTI_ALIAS_FLAG);
+        final RectF tmp = new RectF();
+        final float d;
+        SuperIconSettings settings;
+        Bitmap image;
+        Bitmap icon;
+        Bitmap iconBlur;
+        String label = "";
+        boolean solidStyle;
+        int sx = 2;
+        int sy = 1;
+        int cellW = 1;
+        int cellH = 1;
+        int tint;
+        int defColor;
+        int regular;
+        float baseText;
+        float ratio = 0.5f;
+        Runnable onGesture;
+        float lastK = 1f;
+        float lastX;
+        float lastY;
+        final ScaleGestureDetector scaler;
+
+        Preview(Context c) {
+            super(c);
+            scaler = new ScaleGestureDetector(c,
+                    new ScaleGestureDetector.SimpleOnScaleGestureListener() {
+                        @Override
+                        public boolean onScale(ScaleGestureDetector detector) {
+                            if (settings != null) {
+                                settings.imageZoom = Math.max(SuperIconSettings.MIN_ZOOM,
+                                        Math.min(SuperIconSettings.MAX_ZOOM,
+                                                settings.imageZoom * detector.getScaleFactor()));
+                                invalidate();
+                                if (onGesture != null) {
+                                    onGesture.run();
+                                }
+                            }
+                            return true;
+                        }
+                    });
+            d = c.getResources().getDisplayMetrics().density;
+            stroke.setStyle(Paint.Style.STROKE);
+            stroke.setStrokeWidth(d);
+            backPaint.setColor(0xFF6B6F76);
+        }
+
+        /** Drag to pan and pinch to zoom the background image. */
+        @Override
+        public boolean onTouchEvent(MotionEvent e) {
+            final Bitmap img = currentImage();
+            if (img == null || settings == null) {
+                return super.onTouchEvent(e);
+            }
+            getParent().requestDisallowInterceptTouchEvent(true);
+            scaler.onTouchEvent(e);
+            int action = e.getActionMasked();
+            if (action == MotionEvent.ACTION_DOWN || action == MotionEvent.ACTION_POINTER_DOWN) {
+                lastX = e.getX();
+                lastY = e.getY();
+            } else if (action == MotionEvent.ACTION_POINTER_UP) {
+                int keep = e.getActionIndex() == 0 ? 1 : 0;
+                lastX = e.getX(keep);
+                lastY = e.getY(keep);
+            } else if (action == MotionEvent.ACTION_MOVE && e.getPointerCount() == 1
+                    && !scaler.isInProgress()) {
+                float dx = e.getX() - lastX;
+                float dy = e.getY() - lastY;
+                lastX = e.getX();
+                lastY = e.getY();
+                float bw = img.getWidth();
+                float bh = img.getHeight();
+                float scale = Math.max(lay.pill.width() / bw, lay.pill.height() / bh)
+                        * settings.imageZoom;
+                float rangeX = Math.abs(bw * scale - lay.pill.width()) / 2f;
+                float rangeY = Math.abs(bh * scale - lay.pill.height()) / 2f;
+                if (rangeX > 1f) {
+                    settings.imageX = Math.max(-1f, Math.min(1f,
+                            settings.imageX + dx / (lastK * rangeX)));
+                }
+                if (rangeY > 1f) {
+                    settings.imageY = Math.max(-1f, Math.min(1f,
+                            settings.imageY + dy / (lastK * rangeY)));
+                }
+                invalidate();
+                if (onGesture != null) {
+                    onGesture.run();
+                }
+            }
+            return true;
+        }
+
+        /** The imported image or, if there is none and it is wanted, the softened icon. */
+        Bitmap currentImage() {
+            if (image != null) {
+                return image;
+            }
+            if (settings != null && settings.iconBackground && icon != null) {
+                if (iconBlur == null) {
+                    iconBlur = SuperIconSettings.blurredIcon(icon);
+                }
+                return iconBlur;
+            }
+            return null;
+        }
+
+        int chipCount() {
+            return settings != null && settings.showChips
+                    ? SuperIconLayout.maxChips(sx, sy) : 0;
+        }
+
+        @Override
+        protected void onMeasure(int wSpec, int hSpec) {
+            int w = MeasureSpec.getSize(wSpec);
+            // A one-column tile is narrow: show it at no more than the width of its own size
+            // relative to a 2-wide pill so it does not fill the screen.
+            int vw = cellW * sx;
+            int vh = cellH * sy;
+            float k = Math.min(w / (float) vw, (w * 0.5f) / (float) cellW);
+            setMeasuredDimension(w, Math.round(vh * k) + 1);
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            int vw = cellW * sx;
+            int vh = cellH * sy;
+            float k = Math.min(getWidth() / (float) vw, (getWidth() * 0.5f) / (float) cellW);
+            lastK = k;
+            canvas.drawRoundRect(0, 0, getWidth(), getHeight(), 16 * d, 16 * d, backPaint);
+            canvas.save();
+            canvas.translate((getWidth() - vw * k) / 2f, 0);
+            canvas.scale(k, k);
+            int chips = chipCount();
+            int fillColor = settings.fillColor(solidStyle, tint);
+            lay.compute(vw, vh, sx, sy, fillColor != 0, settings.showIcon, regular, d, ratio,
+                    chips, settings.iconScale);
+            lay.drawBackground(canvas, fillColor, currentImage(), settings, fill, stroke, d);
+            if (settings.showIcon && icon != null) {
+                canvas.drawBitmap(icon, null, lay.icon, null);
+            }
+            int labelColor = settings.resolveLabelColor(fillColor, currentImage() != null, defColor);
+
+            // Placeholders where the app's shortcuts go
+            for (int i = 0; i < lay.chipCountFit; i++) {
+                RectF r = lay.chips[i];
+                if (lay.chipRows) {
+                    fill.setColor(Color.argb(60, 255, 255, 255));
+                    canvas.drawRoundRect(r, r.height() / 2f, r.height() / 2f, fill);
+                    text.setTextSize(baseText * 0.9f);
+                    text.setColor(labelColor);
+                    Paint.FontMetrics fm = text.getFontMetrics();
+                    canvas.drawText("Pintasan " + (i + 1), r.left + 12 * d,
+                            r.centerY() - (fm.ascent + fm.descent) / 2f, text);
+                } else {
+                    fill.setColor(Color.argb(235, 255, 255, 255));
+                    canvas.drawCircle(r.centerX(), r.centerY(), r.width() / 2f, fill);
+                    fill.setColor(0xFF9AA0A6);
+                    canvas.drawCircle(r.centerX(), r.centerY(), r.width() / 5f, fill);
+                }
+            }
+
+            String sub = "";
+            if (settings.subtitleMode == SuperIconSettings.SUB_TEXT) {
+                sub = settings.subtitleText;
+            } else if (settings.subtitleMode == SuperIconSettings.SUB_COUNT) {
+                sub = "3 notifikasi";
+            } else if (settings.subtitleMode == SuperIconSettings.SUB_LAST) {
+                sub = "Nama: isi pesan terakhir";
+            }
+            CharSequence composed = SuperIconSettings.composeText(label, settings.showLabel, sub,
+                    labelColor);
+            if (composed.length() > 0) {
+                text.setTextSize(baseText * settings.labelScale);
+                text.setColor(labelColor);
+                int boxW = Math.max(1, vw - lay.padStart - lay.padEnd);
+                int h = settings.effectiveH(sx, sy);
+                int v = settings.effectiveV(sx, sy, chips);
+                Layout.Alignment align = h == 0 ? Layout.Alignment.ALIGN_NORMAL
+                        : (h == 1 ? Layout.Alignment.ALIGN_CENTER
+                        : Layout.Alignment.ALIGN_OPPOSITE);
+                int maxLines = sub.isEmpty() ? 2 : 3;
+                StaticLayout sl = new StaticLayout(composed, text, boxW, align, 1f, 0f, false);
+                if (sl.getLineCount() > maxLines) {
+                    // Cut after the last line that fits, so the box does not overflow
+                    int end = Math.max(1, sl.getLineEnd(maxLines - 1) - 1);
+                    CharSequence cut = composed.subSequence(0, Math.min(end, composed.length()));
+                    sl = new StaticLayout(TextUtils.concat(cut, "…"), text, boxW, align, 1f, 0f,
+                            false);
+                }
+                float boxH = vh - lay.padTop - lay.padBottom;
+                float y = lay.padTop + (v == 0 ? 0 : (v == 1 ? (boxH - sl.getHeight()) / 2f
+                        : boxH - sl.getHeight()));
+                canvas.translate(lay.padStart, y);
+                sl.draw(canvas);
+            }
+            canvas.restore();
+        }
+    }
+}
diff --git a/src/com/android/launcher3/supericon/SuperIconLayout.java b/src/com/android/launcher3/supericon/SuperIconLayout.java
