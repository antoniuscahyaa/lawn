diff --git a/src/com/android/launcher3/supericon/SuperIconBackupActivity.java b/src/com/android/launcher3/supericon/SuperIconBackupActivity.java
new file mode 100644
index 0000000..fa81125
--- /dev/null
+++ b/src/com/android/launcher3/supericon/SuperIconBackupActivity.java
@@ -0,0 +1,277 @@
+/*
