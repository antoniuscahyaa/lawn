+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package com.android.launcher3.supericon;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Bundle;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipInputStream;
+import java.util.zip.ZipOutputStream;
+
+/**
+ * Backup of the supericon settings and background images: export to a zip file, import from one,
+ * and removal of data that no supericon uses any more.
+ *
+ * Settings are matched by the app's component name, not by the item id, so a backup can be
+ * restored after the supericons have been recreated. Only supericons that are on the workspace
+ * (loaded since the launcher started) are exported, restored into, or kept by the cleanup.
+ */
+public class SuperIconBackupActivity extends Activity {
+
+    private static final int REQ_EXPORT = 1;
+    private static final int REQ_IMPORT = 2;
+    private static final String SETTINGS_ENTRY = "settings.json";
+
+    private TextView mStatus;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        float d = getResources().getDisplayMetrics().density;
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        int pad = (int) (16 * d);
+        root.setPadding(pad, pad, pad, pad);
+
+        TextView title = new TextView(this);
+        title.setText("Cadangan supericon");
+        title.setTextSize(20);
+        root.addView(title);
+
+        TextView info = new TextView(this);
+        info.setText("Ekspor menyimpan pengaturan dan gambar latar semua supericon yang ada di "
+                + "layar utama ke satu file zip. Impor memulihkannya ke supericon dengan "
+                + "aplikasi yang sama. Bersihkan menghapus data supericon yang sudah tidak "
+                + "dipakai.");
+        info.setPadding(0, pad / 2, 0, pad / 2);
+        root.addView(info);
+
+        root.addView(button("Ekspor ke file", v -> {
+            Intent i = new Intent(Intent.ACTION_CREATE_DOCUMENT);
+            i.setType("application/zip");
+            i.addCategory(Intent.CATEGORY_OPENABLE);
+            i.putExtra(Intent.EXTRA_TITLE, "supericon-backup.zip");
+            startActivityForResult(i, REQ_EXPORT);
+        }));
+        root.addView(button("Impor dari file", v -> {
+            Intent i = new Intent(Intent.ACTION_GET_CONTENT);
+            i.setType("*/*");
+            i.addCategory(Intent.CATEGORY_OPENABLE);
+            startActivityForResult(i, REQ_IMPORT);
+        }));
+        root.addView(button("Bersihkan data tak terpakai", v -> cleanup()));
+
+        mStatus = new TextView(this);
+        mStatus.setPadding(0, pad, 0, 0);
+        root.addView(mStatus);
+        setContentView(root);
+    }
+
+    private Button button(String text, View.OnClickListener l) {
+        Button b = new Button(this);
+        b.setText(text);
+        b.setAllCaps(false);
+        b.setOnClickListener(l);
+        b.setLayoutParams(new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        return b;
+    }
+
+    private void say(String text) {
+        mStatus.setText(text);
+        Toast.makeText(this, text, Toast.LENGTH_SHORT).show();
+    }
+
+    private void cleanup() {
+        Map<Long, String> active = SuperIconSettings.activeItems();
+        if (active.isEmpty()) {
+            say("Tidak ada supericon yang termuat. Buka layar utama dulu.");
+            return;
+        }
+        int n = SuperIconSettings.deleteExcept(this, new HashSet<>(active.keySet()));
+        say(n + " data supericon yang tidak dipakai dihapus.");
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (resultCode != RESULT_OK || data == null || data.getData() == null) {
+            return;
+        }
+        final Context ctx = getApplicationContext();
+        final Uri uri = data.getData();
+        final boolean export = requestCode == REQ_EXPORT;
+        if (!export && requestCode != REQ_IMPORT) {
+            return;
+        }
+        new Thread(() -> {
+            String result;
+            try {
+                if (export) {
+                    try (OutputStream out = ctx.getContentResolver().openOutputStream(uri)) {
+                        int n = exportAll(ctx, out);
+                        result = n == 0 ? "Tidak ada supericon dengan pengaturan untuk diekspor."
+                                : n + " supericon diekspor.";
+                    }
+                } else {
+                    try (InputStream in = ctx.getContentResolver().openInputStream(uri)) {
+                        int[] r = importAll(ctx, in);
+                        result = r[0] + " supericon dipulihkan, " + r[1]
+                                + " dilewati (belum ada supericon untuk aplikasinya).";
+                    }
+                }
+            } catch (IOException | JSONException | RuntimeException e) {
+                result = "Gagal: " + e;
+            }
+            final String text = result;
+            runOnUiThread(() -> say(text));
+        }).start();
+    }
+
+    // ------------------------------------------------------------------ zip
+
+    /** Writes the settings and images of all loaded supericons. Returns how many were written. */
+    static int exportAll(Context ctx, OutputStream out) throws IOException, JSONException {
+        JSONArray items = new JSONArray();
+        ZipOutputStream zip = new ZipOutputStream(out);
+        int n = 0;
+        for (Map.Entry<Long, String> e : SuperIconSettings.activeItems().entrySet()) {
+            long id = e.getKey();
+            if (!SuperIconSettings.hasStored(ctx, id)) {
+                continue;
+            }
+            JSONObject o = new JSONObject();
+            o.put("component", e.getValue());
+            o.put("settings", SuperIconSettings.load(ctx, id).toJson());
+            File img = SuperIconSettings.imageFile(ctx, id);
+            if (img.exists()) {
+                String name = "images/" + n + ".png";
+                zip.putNextEntry(new ZipEntry(name));
+                byte[] bytes;
+                try (java.io.FileInputStream fi = new java.io.FileInputStream(img)) {
+                    bytes = readAll(fi);
+                }
+                zip.write(bytes);
+                zip.closeEntry();
+                o.put("image", name);
+            }
+            items.put(o);
+            n++;
+        }
+        JSONObject root = new JSONObject();
+        root.put("version", 1);
+        root.put("items", items);
+        zip.putNextEntry(new ZipEntry(SETTINGS_ENTRY));
+        zip.write(root.toString().getBytes(StandardCharsets.UTF_8));
+        zip.closeEntry();
+        zip.finish();
+        zip.flush();
+        return n;
+    }
+
+    /** Restores a backup into the loaded supericons. Returns {restored, skipped}. */
+    static int[] importAll(Context ctx, InputStream in) throws IOException, JSONException {
+        Map<String, byte[]> entries = new HashMap<>();
+        try (ZipInputStream zip = new ZipInputStream(in)) {
+            ZipEntry e;
+            while ((e = zip.getNextEntry()) != null) {
+                entries.put(e.getName(), readAll(zip));
+            }
+        }
+        byte[] settings = entries.get(SETTINGS_ENTRY);
+        if (settings == null) {
+            throw new IOException("Bukan file cadangan supericon");
+        }
+        JSONArray items = new JSONObject(new String(settings, StandardCharsets.UTF_8))
+                .getJSONArray("items");
+        Map<Long, String> active = SuperIconSettings.activeItems();
+        Set<Long> touched = new HashSet<>();
+        int restored = 0;
+        int skipped = 0;
+        for (int i = 0; i < items.length(); i++) {
+            JSONObject o = items.getJSONObject(i);
+            String component = o.optString("component");
+            SuperIconSettings s = SuperIconSettings.fromJson(o.getJSONObject("settings"));
+            String imageName = o.optString("image", "");
+            byte[] image = imageName.isEmpty() ? null : entries.get(imageName);
+            boolean any = false;
+            for (Map.Entry<Long, String> a : active.entrySet()) {
+                if (!a.getValue().equals(component) || touched.contains(a.getKey())) {
+                    continue;
+                }
+                long id = a.getKey();
+                touched.add(id);
+                s.save(ctx, id);
+                File f = SuperIconSettings.imageFile(ctx, id);
+                if (image != null) {
+                    try (FileOutputStream fo = new FileOutputStream(f)) {
+                        fo.write(image);
+                    }
+                } else {
+                    f.delete();
+                }
+                any = true;
+                restored++;
+                break;
+            }
+            if (!any) {
+                skipped++;
+            }
+        }
+        final Set<Long> ids = touched;
+        new android.os.Handler(android.os.Looper.getMainLooper()).post(() -> {
+            for (long id : ids) {
+                SuperIconSettings.notifyChanged(id);
+            }
+        });
+        return new int[] {restored, skipped};
+    }
+
+    private static byte[] readAll(InputStream in) throws IOException {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        byte[] buf = new byte[8192];
+        int n;
+        while ((n = in.read(buf)) > 0) {
+            bos.write(buf, 0, n);
+        }
+        return bos.toByteArray();
+    }
+}
