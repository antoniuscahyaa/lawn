+package com.android.launcher3.supericon;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+import android.net.Uri;
+import android.text.SpannableStringBuilder;
+import android.text.style.ForegroundColorSpan;
+import android.text.style.RelativeSizeSpan;
+import android.util.LruCache;
+
+import androidx.core.graphics.ColorUtils;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+import java.util.WeakHashMap;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Per-supericon customisation: background colour and image (zoom in or out, pan, dimming), label
+ * colour, size and position, and what is shown (icon, label, app shortcuts). Stored in
+ * SharedPreferences (one JSON string per item id); the background image is a PNG in the app's
+ * files directory.
+ */
+public final class SuperIconSettings {
+
+    private static final String PREFS = "supericon_settings";
+    private static final int MAX_IMAGE_SIDE = 1024;
+
+    public static final int BG_STYLE = 0;
+    public static final int BG_ADAPTIVE = 1;
+    public static final int BG_CUSTOM = 2;
+
+    public static final int SUB_NONE = 0;
+    public static final int SUB_TEXT = 1;
+    public static final int SUB_COUNT = 2;
+    public static final int SUB_LAST = 3;
+
+    public static final int GESTURE_NONE = 0;
+    public static final int GESTURE_SHORTCUT = 1;
+    public static final int GESTURE_APP = 2;
+
+    public static final float MIN_ZOOM = 0.3f;
+    public static final float MAX_ZOOM = 3f;
+
+    /** Background image zoom: below 1 the image is smaller than the pill, above 1 it is cropped. */
+    public float imageZoom = 1f;
+    /** Background image pan, -1..1. */
+    public float imageX = 0f;
+    public float imageY = 0f;
+    /** Darkening on top of the image, 0..80 percent. */
+    public int imageDim = 35;
+    /** Background: {@link #BG_STYLE} (from the style), {@link #BG_ADAPTIVE} (the icon's colour)
+     *  or {@link #BG_CUSTOM} ({@link #bgColor}). */
+    public int bgMode = BG_STYLE;
+    public int bgColor = 0xFF2D2D2D;
+    /** Label colour, or 0 for automatic. */
+    public int labelColor = 0;
+    /** Label size multiplier, 0.5..1.6. */
+    public float labelScale = 1f;
+    /** Label position: 0..2 horizontally (start, centre, end) and vertically (top, centre,
+     *  bottom), or -1 for the default of the current size. */
+    public int labelH = -1;
+    public int labelV = -1;
+    public boolean showIcon = true;
+    public boolean showLabel = true;
+    public boolean showChips = true;
+    /** Background made from the app's own icon, enlarged and softened (used when there is no
+     *  imported image). */
+    public boolean iconBackground = false;
+    /** What swiping up or down on the supericon does: nothing, the app's first shortcut (or the
+     *  first of the chosen ones), or another app (a flattened component name). */
+    public int swipeUp = GESTURE_NONE;
+    public String swipeUpApp = "";
+    public int swipeDown = GESTURE_NONE;
+    public String swipeDownApp = "";
+    /** Whether the icon shows its notification dot. */
+    public boolean showDot = true;
+    /** Whether the long-press menu lists the app's shortcuts and notifications. */
+    public boolean popupExtras = true;
+    /** Ids of the app shortcuts to show as chips, in order; empty means the first ones found. */
+    public ArrayList<String> chipIds = new ArrayList<>();
+    /** Icon size multiplier, 0.5..1.4, and whether the solid style puts it in a white ring. */
+    public float iconScale = 1f;
+    public boolean iconRing = true;
+    /** Opacity of the glass style's fill, 5..60 percent, and whether it has a highlight. */
+    public int glassAlpha = 25;
+    public boolean glassShine = false;
+    /** Second line under the label: nothing, {@link #subtitleText}, the notification count or
+     *  the text of the latest notification. */
+    public int subtitleMode = SUB_NONE;
+    public String subtitleText = "";
+
+    public interface Listener {
+        void onSuperIconSettingsChanged(long itemId);
+    }
+
+    private static final Set<Listener> sListeners =
+            Collections.newSetFromMap(new WeakHashMap<Listener, Boolean>());
+    private static final LruCache<String, Bitmap> sImages = new LruCache<>(6);
+    /** Supericons currently on the workspace: item id to the app's component name. */
+    private static final Map<Long, String> sActive = new ConcurrentHashMap<>();
+
+    private static final Paint sImagePaint =
+            new Paint(Paint.ANTI_ALIAS_FLAG | Paint.FILTER_BITMAP_FLAG);
+    private static final Paint sDimPaint = new Paint();
+    private static final Path sClip = new Path();
+    private static final RectF sDst = new RectF();
+
+    // ------------------------------------------------------------ resolution
+
+    public static int defaultH(int spanX, int spanY) {
+        return spanX == 1 && spanY == 2 ? 1 : 0;
+    }
+
+    public static int defaultV(int spanX, int spanY, int chipCount) {
+        if (spanY == 2 && spanX >= 2) {
+            return chipCount > 0 ? 1 : 2;
+        }
+        return spanY == 2 ? 2 : 1;
+    }
+
+    public int effectiveH(int spanX, int spanY) {
+        return labelH >= 0 ? labelH : defaultH(spanX, spanY);
+    }
+
+    public int effectiveV(int spanX, int spanY, int chipCount) {
+        return labelV >= 0 ? labelV : defaultV(spanX, spanY, chipCount);
+    }
+
+    /** The pill's fill colour, or 0 for the translucent glass look. */
+    public int fillColor(boolean solidStyle, int tint) {
+        if (bgMode == BG_CUSTOM) {
+            return (bgColor >>> 24) == 0 ? (bgColor | 0xFF000000) : bgColor;
+        }
+        if (bgMode == BG_ADAPTIVE) {
+            return tint;
+        }
+        return solidStyle ? tint : 0;
+    }
+
+    /** The label colour to use; {@code defaultColor} applies only over the plain glass look. */
+    public int resolveLabelColor(int fill, boolean hasImage, int defaultColor) {
+        if (labelColor != 0) {
+            return labelColor;
+        }
+        if (hasImage && imageZoom >= 1f) {
+            return Color.WHITE;
+        }
+        if (fill != 0) {
+            return ColorUtils.calculateLuminance(fill | 0xFF000000) > 0.55
+                    ? Color.argb(230, 20, 20, 20) : Color.WHITE;
+        }
+        return defaultColor;
+    }
+
+    /**
+     * The text of the label box: the app name (if shown) and, under it in a smaller size and a
+     * lighter shade, the subtitle. Empty if there is neither.
+     */
+    public static CharSequence composeText(CharSequence label, boolean showLabel,
+            String subtitle, int labelColor) {
+        boolean hasLabel = showLabel && label != null && label.length() > 0;
+        boolean hasSub = subtitle != null && !subtitle.isEmpty();
+        if (!hasLabel && !hasSub) {
+            return "";
+        }
+        if (!hasSub) {
+            return label;
+        }
+        SpannableStringBuilder b = new SpannableStringBuilder();
+        if (hasLabel) {
+            b.append(label);
+            b.append('\n');
+        }
+        int start = b.length();
+        b.append(subtitle);
+        b.setSpan(new RelativeSizeSpan(0.82f), start, b.length(), 0);
+        b.setSpan(new ForegroundColorSpan(Color.argb(204, Color.red(labelColor),
+                Color.green(labelColor), Color.blue(labelColor))), start, b.length(), 0);
+        return b;
+    }
+
+    /**
+     * A soft version of the app icon to use as a background: its middle part, shrunk a lot so
+     * that drawing it enlarged blurs it. Returns null if that is not possible.
+     */
+    public static Bitmap blurredIcon(Bitmap icon) {
+        if (icon == null) {
+            return null;
+        }
+        try {
+            int w = icon.getWidth();
+            int h = icon.getHeight();
+            if (w < 8 || h < 8) {
+                return icon;
+            }
+            Bitmap crop = Bitmap.createBitmap(icon, w * 15 / 100, h * 15 / 100,
+                    w * 70 / 100, h * 70 / 100);
+            return Bitmap.createScaledBitmap(crop, Math.max(2, crop.getWidth() / 10),
+                    Math.max(2, crop.getHeight() / 10), true);
+        } catch (RuntimeException e) {
+            return null;
+        }
+    }
+
+    // ------------------------------------------------------------ style clipboard
+
+    /** A copied style: the settings, the style, and optionally the background image. */
+    public static final class Clip {
+        public SuperIconSettings settings;
+        public boolean solid;
+        public File image;
+    }
+
+    public static void saveClip(Context context, SuperIconSettings s, boolean solid,
+            File image) {
+        try {
+            JSONObject o = new JSONObject();
+            o.put("s", s.toJson());
+            o.put("solid", solid);
+            prefs(context).edit().putString("clip", o.toString()).apply();
+        } catch (JSONException e) {
+            return;
+        }
+        File dest = new File(dir(context), "clip.png");
+        dest.delete();
+        if (image != null && image.exists()) {
+            copyFile(image, dest);
+        }
+    }
+
+    public static Clip loadClip(Context context) {
+        String json = prefs(context).getString("clip", null);
+        if (json == null) {
+            return null;
+        }
+        try {
+            JSONObject o = new JSONObject(json);
+            Clip c = new Clip();
+            c.settings = fromJson(o.getJSONObject("s"));
+            c.solid = o.optBoolean("solid", true);
+            File f = new File(dir(context), "clip.png");
+            c.image = f.exists() ? f : null;
+            return c;
+        } catch (JSONException e) {
+            return null;
+        }
+    }
+
+    public static boolean copyFile(File from, File to) {
+        try (InputStream in = new java.io.FileInputStream(from);
+                FileOutputStream out = new FileOutputStream(to)) {
+            byte[] buf = new byte[8192];
+            int n;
+            while ((n = in.read(buf)) > 0) {
+                out.write(buf, 0, n);
+            }
+            return true;
+        } catch (IOException e) {
+            return false;
+        }
+    }
+
+    // --------------------------------------------------------------- storage
+
+    public JSONObject toJson() throws JSONException {
+        JSONObject o = new JSONObject();
+        o.put("zoom", imageZoom);
+        o.put("x", imageX);
+        o.put("y", imageY);
+        o.put("dim", imageDim);
+        o.put("bgMode", bgMode);
+        o.put("bgColor", bgColor);
+        o.put("color", labelColor);
+        o.put("scale", labelScale);
+        o.put("h", labelH);
+        o.put("v", labelV);
+        o.put("icon", showIcon);
+        o.put("label", showLabel);
+        o.put("chips", showChips);
+        o.put("iconBg", iconBackground);
+        o.put("swUp", swipeUp);
+        o.put("swUpApp", swipeUpApp);
+        o.put("swDown", swipeDown);
+        o.put("swDownApp", swipeDownApp);
+        o.put("dot", showDot);
+        o.put("popup", popupExtras);
+        o.put("chipIds", new JSONArray(chipIds));
+        o.put("iconScale", iconScale);
+        o.put("ring", iconRing);
+        o.put("glassAlpha", glassAlpha);
+        o.put("shine", glassShine);
+        o.put("subMode", subtitleMode);
+        o.put("subText", subtitleText);
+        return o;
+    }
+
+    public static SuperIconSettings fromJson(JSONObject o) {
+        SuperIconSettings s = new SuperIconSettings();
+        s.imageZoom = clamp((float) o.optDouble("zoom", 1), MIN_ZOOM, MAX_ZOOM);
+        s.imageX = clamp((float) o.optDouble("x", 0), -1f, 1f);
+        s.imageY = clamp((float) o.optDouble("y", 0), -1f, 1f);
+        s.imageDim = Math.max(0, Math.min(80, o.optInt("dim", 35)));
+        s.bgMode = Math.max(0, Math.min(2, o.optInt("bgMode", BG_STYLE)));
+        s.bgColor = o.optInt("bgColor", 0xFF2D2D2D);
+        s.labelColor = o.optInt("color", 0);
+        s.labelScale = clamp((float) o.optDouble("scale", 1), 0.5f, 1.6f);
+        s.labelH = Math.max(-1, Math.min(2, o.optInt("h", -1)));
+        s.labelV = Math.max(-1, Math.min(2, o.optInt("v", -1)));
+        s.showIcon = o.optBoolean("icon", true);
+        s.showLabel = o.optBoolean("label", true);
+        s.showChips = o.optBoolean("chips", true);
