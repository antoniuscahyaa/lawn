+    /** Opens the editor for the supericon's image, label colour, size and position. */
+    private static void customize(Launcher launcher, WorkspaceItemInfo info, SuperIconView view) {
+        Intent i = new Intent(launcher, SuperIconEditActivity.class);
+        i.putExtra(SuperIconEditActivity.EXTRA_ID, info.id);
+        i.putExtra(SuperIconEditActivity.EXTRA_LABEL,
+                info.title == null ? "" : info.title.toString());
+        i.putExtra(SuperIconEditActivity.EXTRA_SOLID,
+                WorkspaceItemInfo.isSolidStyle(info.superStyle));
+        i.putExtra(SuperIconEditActivity.EXTRA_CARD, info.spanY > 1);
+        i.putExtra(SuperIconEditActivity.EXTRA_W, view.getWidth());
+        i.putExtra(SuperIconEditActivity.EXTRA_H, view.getHeight());
+        i.putExtra(SuperIconEditActivity.EXTRA_REGULAR, view.getRegularIconSizePx());
+        i.putExtra(SuperIconEditActivity.EXTRA_TEXT_SIZE, view.getBaseTextSizePx());
+        i.putExtra(SuperIconEditActivity.EXTRA_TINT,
+                info.iconColor != 0 ? (info.iconColor | 0xFF000000) : 0xFF5F5E5A);
+        i.putExtra(SuperIconEditActivity.EXTRA_DEFAULT_COLOR, view.getDefaultLabelColor());
+        i.putExtra(SuperIconEditActivity.EXTRA_RATIO, SuperIconView.cornerRatio());
+        Bitmap bmp = info.iconBitmap;
+        if (bmp != null) {
+            File f = new File(launcher.getCacheDir(), "supericon_icon_" + info.id + ".png");
+            try (FileOutputStream os = new FileOutputStream(f)) {
+                bmp.compress(Bitmap.CompressFormat.PNG, 100, os);
+                i.putExtra(SuperIconEditActivity.EXTRA_ICON, f.getAbsolutePath());
+            } catch (IOException e) {
+                // The preview is simply drawn without the icon
+            }
+        }
+        launcher.startActivity(i);
+    }
