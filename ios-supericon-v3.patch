+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        Intent in = getIntent();
+        mId = in.getLongExtra(EXTRA_ID, -1);
+        if (mId < 0) {
+            finish();
+            return;
+        }
+        mD = getResources().getDisplayMetrics().density;
+        mSettings = SuperIconSettings.load(this, mId);
+        mSolidStyle = in.getBooleanExtra(EXTRA_SOLID, true);
