+        });
+        mPanY = seek(root, "Geser tegak", 0, 200, v -> {
+            mSettings.imageY = (v - 100) / 100f;
+            mPreview.invalidate();
+        });
+        mDim = seek(root, "Gelapkan gambar", 0, 80, v -> {
