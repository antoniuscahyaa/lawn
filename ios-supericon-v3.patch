+package com.android.launcher3.supericon;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.Intent;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.drawable.GradientDrawable;
+import android.os.Bundle;
+import android.text.Layout;
+import android.text.StaticLayout;
+import android.text.TextPaint;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.CheckBox;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.SeekBar;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import java.io.File;
+
+/**
+ * Editor for one supericon: background image (import, zoom, pan, dimming), label colour, size
+ * and position, and icon visibility. Opened from the supericon menu with the item's id and the
+ * size of its view; the preview uses the same geometry as the workspace view.
+ */
+public class SuperIconEditActivity extends Activity {
+
+    public static final String EXTRA_ID = "id";
+    public static final String EXTRA_LABEL = "label";
+    public static final String EXTRA_SOLID = "solid";
+    public static final String EXTRA_CARD = "card";
+    public static final String EXTRA_W = "w";
+    public static final String EXTRA_H = "h";
+    public static final String EXTRA_REGULAR = "regular";
+    public static final String EXTRA_TEXT_SIZE = "textSize";
+    public static final String EXTRA_TINT = "tint";
+    public static final String EXTRA_DEFAULT_COLOR = "defColor";
+    public static final String EXTRA_RATIO = "ratio";
+    public static final String EXTRA_ICON = "icon";
+
+    private static final int REQ_PICK = 1;
+    private static final int[] SWATCHES = {
+            0, Color.WHITE, Color.BLACK, 0xFFFFD60A, 0xFFFF6B9D, 0xFF64D2FF, 0xFF30D158};
+
+    private interface OnValue {
+        void on(int value);
+    }
+
+    private long mId;
+    private SuperIconSettings mSettings;
+    private File mPending;
+    private boolean mRemoveImage;
+    private Preview mPreview;
+    private SeekBar mZoom, mPanX, mPanY, mDim, mLabelSize;
+    private CheckBox mShowIcon;
+    private final View[] mSwatchViews = new View[SWATCHES.length];
+    private final Button[] mGrid = new Button[9];
+    private float mD;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        Intent in = getIntent();
+        mId = in.getLongExtra(EXTRA_ID, -1);
+        if (mId < 0) {
+            finish();
+            return;
+        }
+        mD = getResources().getDisplayMetrics().density;
+        mSettings = SuperIconSettings.load(this, mId);
+
+        mPreview = new Preview(this);
+        mPreview.solid = in.getBooleanExtra(EXTRA_SOLID, true);
+        mPreview.card = in.getBooleanExtra(EXTRA_CARD, false);
+        mPreview.vw = Math.max(1, in.getIntExtra(EXTRA_W, 1));
+        mPreview.vh = Math.max(1, in.getIntExtra(EXTRA_H, 1));
+        mPreview.regular = in.getIntExtra(EXTRA_REGULAR, (int) (56 * mD));
+        mPreview.baseText = in.getFloatExtra(EXTRA_TEXT_SIZE, 12 * mD);
+        mPreview.tint = in.getIntExtra(EXTRA_TINT, 0xFF5F5E5A);
+        mPreview.defColor = in.getIntExtra(EXTRA_DEFAULT_COLOR, Color.WHITE);
+        mPreview.ratio = in.getFloatExtra(EXTRA_RATIO, 0.5f);
+        String label = in.getStringExtra(EXTRA_LABEL);
+        mPreview.label = label == null ? "" : label;
+        String iconPath = in.getStringExtra(EXTRA_ICON);
+        if (iconPath != null) {
+            mPreview.icon = BitmapFactory.decodeFile(iconPath);
+        }
+        mPreview.settings = mSettings;
+        mPreview.image = SuperIconSettings.loadImage(this, mId);
+
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        int pad = (int) (16 * mD);
+        root.setPadding(pad, pad, pad, pad);
+
+        TextView title = new TextView(this);
+        title.setText("Sesuaikan supericon");
+        title.setTextSize(20);
+        root.addView(title);
+
+        LinearLayout.LayoutParams pl = new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        pl.topMargin = pad;
+        pl.bottomMargin = pad / 2;
+        root.addView(mPreview, pl);
+
+        LinearLayout imgButtons = row();
+        imgButtons.addView(button("Pilih gambar", v -> pickImage()), weight());
+        imgButtons.addView(button("Hapus gambar", v -> {
+            mPreview.image = null;
+            mRemoveImage = true;
+            if (mPending != null) {
+                mPending.delete();
+                mPending = null;
+            }
+            mPreview.invalidate();
+        }), weight());
+        root.addView(imgButtons);
+
+        root.addView(section("Gambar latar"));
+        mZoom = seek(root, "Perbesar", 0, 200, 0, v -> {
+            mSettings.imageZoom = 1f + v / 100f;
+            mPreview.invalidate();
+        });
+        mPanX = seek(root, "Geser mendatar", 0, 200, 0, v -> {
+            mSettings.imageX = (v - 100) / 100f;
+            mPreview.invalidate();
+        });
+        mPanY = seek(root, "Geser tegak", 0, 200, 0, v -> {
+            mSettings.imageY = (v - 100) / 100f;
+            mPreview.invalidate();
+        });
+        mDim = seek(root, "Gelapkan gambar", 0, 80, 0, v -> {
+            mSettings.imageDim = v;
+            mPreview.invalidate();
+        });
+
+        root.addView(section("Label"));
+        LinearLayout swatches = row();
+        for (int i = 0; i < SWATCHES.length; i++) {
+            final int color = SWATCHES[i];
+            TextView sw = new TextView(this);
+            sw.setGravity(Gravity.CENTER);
+            sw.setText(color == 0 ? "A" : "");
+            sw.setTextColor(Color.BLACK);
+            LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(
+                    (int) (36 * mD), (int) (36 * mD));
+            lp.rightMargin = (int) (8 * mD);
+            sw.setOnClickListener(v -> {
+                mSettings.labelColor = color;
+                refreshSwatches();
+                mPreview.invalidate();
+            });
+            mSwatchViews[i] = sw;
+            swatches.addView(sw, lp);
+        }
+        root.addView(swatches);
+        mLabelSize = seek(root, "Ukuran label (%)", 50, 160, 100, v -> {
+            mSettings.labelScale = v / 100f;
+            mPreview.invalidate();
+        });
+
+        TextView posLabel = new TextView(this);
+        posLabel.setText("Letak label");
+        root.addView(posLabel);
+        LinearLayout grid = new LinearLayout(this);
+        grid.setOrientation(LinearLayout.VERTICAL);
+        for (int r = 0; r < 3; r++) {
+            LinearLayout line = row();
+            for (int c = 0; c < 3; c++) {
+                final int vv = r;
+                final int hh = c;
+                Button b = button("", v -> {
+                    mSettings.labelH = hh;
+                    mSettings.labelV = vv;
+                    refreshGrid();
+                    mPreview.invalidate();
+                });
+                mGrid[r * 3 + c] = b;
+                line.addView(b, new LinearLayout.LayoutParams((int) (56 * mD),
+                        (int) (44 * mD)));
+            }
+            grid.addView(line);
+        }
+        root.addView(grid);
+        root.addView(button("Letak bawaan", v -> {
+            mSettings.labelH = -1;
+            mSettings.labelV = -1;
+            refreshGrid();
+            mPreview.invalidate();
+        }));
+
+        mShowIcon = new CheckBox(this);
+        mShowIcon.setText("Tampilkan ikon");
+        mShowIcon.setOnCheckedChangeListener((b, checked) -> {
+            mSettings.showIcon = checked;
+            mPreview.invalidate();
+        });
+        root.addView(mShowIcon);
+
+        LinearLayout actions = row();
+        actions.addView(button("Atur ulang", v -> resetAll()), weight());
+        actions.addView(button("Batal", v -> cancel()), weight());
+        actions.addView(button("Simpan", v -> save()), weight());
+        LinearLayout.LayoutParams al = new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        al.topMargin = pad;
+        root.addView(actions, al);
+
+        ScrollView scroll = new ScrollView(this);
+        scroll.addView(root);
+        setContentView(scroll);
+        syncControls();
+    }
+
+    // ------------------------------------------------------------ UI helpers
+
+    private LinearLayout row() {
+        LinearLayout l = new LinearLayout(this);
+        l.setOrientation(LinearLayout.HORIZONTAL);
+        return l;
+    }
+
+    private LinearLayout.LayoutParams weight() {
+        return new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f);
+    }
+
+    private Button button(String text, View.OnClickListener l) {
+        Button b = new Button(this);
+        b.setText(text);
+        b.setAllCaps(false);
+        b.setOnClickListener(l);
+        return b;
+    }
+
+    private TextView section(String text) {
+        TextView t = new TextView(this);
+        t.setText(text);
+        t.setTextSize(16);
+        t.setPadding(0, (int) (16 * mD), 0, (int) (4 * mD));
+        return t;
+    }
+
+    private SeekBar seek(LinearLayout parent, String label, int min, int max, int unused,
+            OnValue cb) {
+        TextView t = new TextView(this);
+        t.setText(label);
+        parent.addView(t);
+        SeekBar s = new SeekBar(this);
+        s.setMax(max - min);
+        s.setTag(min);
+        s.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
+            @Override
+            public void onProgressChanged(SeekBar bar, int progress, boolean fromUser) {
+                if (fromUser) {
+                    cb.on(progress + min);
+                }
+            }
+
+            @Override
+            public void onStartTrackingTouch(SeekBar bar) { }
+
+            @Override
+            public void onStopTrackingTouch(SeekBar bar) { }
+        });
+        parent.addView(s);
+        return s;
+    }
+
+    private static void setSeek(SeekBar bar, int value) {
+        bar.setProgress(value - (Integer) bar.getTag());
+    }
+
+    /** Pushes the current settings into the controls. */
+    private void syncControls() {
+        setSeek(mZoom, Math.round((mSettings.imageZoom - 1f) * 100));
+        setSeek(mPanX, Math.round(mSettings.imageX * 100) + 100);
+        setSeek(mPanY, Math.round(mSettings.imageY * 100) + 100);
+        setSeek(mDim, mSettings.imageDim);
+        setSeek(mLabelSize, Math.round(mSettings.labelScale * 100));
+        mShowIcon.setChecked(mSettings.showIcon);
+        refreshSwatches();
+        refreshGrid();
+        mPreview.settings = mSettings;
+        mPreview.invalidate();
+    }
+
+    private void refreshSwatches() {
+        for (int i = 0; i < SWATCHES.length; i++) {
+            GradientDrawable g = new GradientDrawable();
+            g.setShape(GradientDrawable.OVAL);
+            g.setColor(SWATCHES[i] == 0 ? 0xFFDDDDDD : SWATCHES[i]);
+            boolean on = SWATCHES[i] == mSettings.labelColor;
+            g.setStroke((int) ((on ? 3 : 1) * mD), on ? 0xFF1A73E8 : 0xFF888888);
+            mSwatchViews[i].setBackground(g);
+        }
+    }
+
+    private void refreshGrid() {
+        int h = mSettings.effectiveH();
+        int v = mSettings.effectiveV(mPreview.card);
+        for (int r = 0; r < 3; r++) {
+            for (int c = 0; c < 3; c++) {
+                mGrid[r * 3 + c].setText(r == v && c == h ? "●" : "○");
+            }
+        }
+    }
+
+    // --------------------------------------------------------------- actions
+
+    private void pickImage() {
+        Intent i = new Intent(Intent.ACTION_GET_CONTENT);
+        i.setType("image/*");
+        i.addCategory(Intent.CATEGORY_OPENABLE);
+        try {
+            startActivityForResult(i, REQ_PICK);
+        } catch (RuntimeException e) {
+            Toast.makeText(this, "Tidak ada aplikasi untuk memilih gambar", Toast.LENGTH_SHORT)
+                    .show();
+        }
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (requestCode != REQ_PICK || resultCode != RESULT_OK || data == null
+                || data.getData() == null) {
+            return;
+        }
+        final Context ctx = getApplicationContext();
+        final File dest = SuperIconSettings.tempImageFile(ctx, mId);
+        final android.net.Uri uri = data.getData();
+        new Thread(() -> {
+            final boolean ok = SuperIconSettings.importImage(ctx, uri, dest);
+            runOnUiThread(() -> {
+                if (isFinishing()) {
+                    return;
+                }
+                Bitmap b = ok ? BitmapFactory.decodeFile(dest.getAbsolutePath()) : null;
+                if (b == null) {
+                    Toast.makeText(this, "Gambar tidak bisa dibuka", Toast.LENGTH_SHORT).show();
+                    return;
+                }
+                mPending = dest;
+                mRemoveImage = false;
+                mPreview.image = b;
+                mPreview.invalidate();
+            });
+        }).start();
+    }
+
+    private void resetAll() {
+        mSettings = new SuperIconSettings();
+        mPreview.image = null;
+        mRemoveImage = true;
+        if (mPending != null) {
+            mPending.delete();
+            mPending = null;
+        }
+        syncControls();
+    }
+
+    private void cancel() {
+        SuperIconSettings.tempImageFile(this, mId).delete();
+        finish();
+    }
+
+    private void save() {
+        File fin = SuperIconSettings.imageFile(this, mId);
+        if (mRemoveImage) {
+            fin.delete();
+        }
+        if (mPending != null && mPending.exists()) {
+            fin.delete();
+            if (!mPending.renameTo(fin)) {
+                Toast.makeText(this, "Gambar gagal disimpan", Toast.LENGTH_SHORT).show();
+            }
+        }
+        mSettings.save(this, mId);
+        SuperIconSettings.notifyChanged(mId);
+        finish();
+    }
+
+    @Override
+    protected void onDestroy() {
+        super.onDestroy();
+        if (mId >= 0 && !isChangingConfigurations()) {
+            SuperIconSettings.tempImageFile(this, mId).delete();
+        }
+    }
+
+    // --------------------------------------------------------------- preview
+
+    /** Draws a supericon at the size of the real view, scaled to the width available. */
+    private static class Preview extends View {
+        final SuperIconLayout lay = new SuperIconLayout();
+        final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+        final Paint stroke = new Paint(Paint.ANTI_ALIAS_FLAG);
+        final Paint backPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        final TextPaint text = new TextPaint(Paint.ANTI_ALIAS_FLAG);
+        final float d;
+        SuperIconSettings settings;
+        Bitmap image;
+        Bitmap icon;
+        String label = "";
+        boolean solid;
+        boolean card;
+        int tint;
+        int defColor;
+        int vw = 1;
+        int vh = 1;
+        int regular;
+        float baseText;
+        float ratio = 0.5f;
+
+        Preview(Context c) {
+            super(c);
+            d = c.getResources().getDisplayMetrics().density;
+            stroke.setStyle(Paint.Style.STROKE);
+            stroke.setStrokeWidth(d);
+            backPaint.setColor(0xFF6B6F76);
+        }
+
+        @Override
+        protected void onMeasure(int wSpec, int hSpec) {
+            int w = MeasureSpec.getSize(wSpec);
+            setMeasuredDimension(w, Math.round(w * vh / (float) vw));
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            float k = getWidth() / (float) vw;
+            canvas.drawRoundRect(0, 0, getWidth(), getHeight(), 16 * d, 16 * d, backPaint);
+            canvas.save();
+            canvas.scale(k, k);
+            lay.compute(vw, vh, card, solid, settings.showIcon, regular, d * 1f, ratio);
+            lay.drawBackground(canvas, solid, tint, image, settings, fill, stroke, d);
+            if (settings.showIcon && icon != null) {
+                canvas.drawBitmap(icon, null, lay.icon, null);
+            }
+
+            text.setTextSize(baseText * settings.labelScale);
+            text.setColor(settings.resolveLabelColor(solid, tint, image != null, defColor));
+            int boxW = Math.max(1, vw - lay.padStart - lay.padEnd);
+            int h = settings.effectiveH();
+            int v = settings.effectiveV(card);
+            Layout.Alignment align = h == 0 ? Layout.Alignment.ALIGN_NORMAL
+                    : (h == 1 ? Layout.Alignment.ALIGN_CENTER : Layout.Alignment.ALIGN_OPPOSITE);
+            String shown = label;
+            StaticLayout sl = new StaticLayout(shown, text, boxW, align, 1f, 0f, false);
+            if (sl.getLineCount() > 2) {
+                int end = Math.max(1, sl.getLineEnd(1) - 1);
+                shown = label.substring(0, Math.min(end, label.length())).trim() + "…";
+                sl = new StaticLayout(shown, text, boxW, align, 1f, 0f, false);
+            }
+            float boxH = vh - lay.padTop - lay.padBottom;
+            float y = lay.padTop + (v == 0 ? 0 : (v == 1 ? (boxH - sl.getHeight()) / 2f
+                    : boxH - sl.getHeight()));
+            canvas.translate(lay.padStart, y);
+            sl.draw(canvas);
+            canvas.restore();
+        }
+    }
+}
