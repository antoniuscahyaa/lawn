+ * limitations under the License.
+ */
+package com.android.launcher3.supericon;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+import android.net.Uri;
+import android.util.LruCache;
+
+import androidx.core.graphics.ColorUtils;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Set;
+import java.util.WeakHashMap;
+
+/**
+ * Per-supericon customisation: background image (zoom, pan, dimming), label colour, size and
+ * position, and icon visibility. Stored in SharedPreferences (one JSON string per item id); the
+ * background image is a PNG in the app's files directory.
+ */
+public final class SuperIconSettings {
+
+    private static final String PREFS = "supericon_settings";
+    private static final int MAX_IMAGE_SIDE = 1024;
+
+    /** Background image zoom, 1..3. */
+    public float imageZoom = 1f;
+    /** Background image pan, -1..1. */
+    public float imageX = 0f;
+    public float imageY = 0f;
+    /** Darkening on top of the image, 0..80 percent. */
+    public int imageDim = 35;
+    /** Label colour, or 0 for automatic. */
+    public int labelColor = 0;
+    /** Label size multiplier, 0.5..1.6. */
+    public float labelScale = 1f;
+    /** Label position: 0..2 horizontally (start, centre, end) and vertically (top, centre,
+     *  bottom), or -1 for the default of the current size. */
+    public int labelH = -1;
+    public int labelV = -1;
+    public boolean showIcon = true;
+
+    public interface Listener {
+        void onSuperIconSettingsChanged(long itemId);
+    }
+
+    private static final Set<Listener> sListeners =
+            Collections.newSetFromMap(new WeakHashMap<Listener, Boolean>());
+    private static final LruCache<String, Bitmap> sImages = new LruCache<>(6);
+
+    private static final Paint sImagePaint = new Paint(Paint.ANTI_ALIAS_FLAG | Paint.FILTER_BITMAP_FLAG);
+    private static final Paint sDimPaint = new Paint();
+    private static final Path sClip = new Path();
+    private static final RectF sDst = new RectF();
+
+    public SuperIconSettings copy() {
+        SuperIconSettings s = new SuperIconSettings();
+        s.imageZoom = imageZoom;
+        s.imageX = imageX;
+        s.imageY = imageY;
+        s.imageDim = imageDim;
+        s.labelColor = labelColor;
+        s.labelScale = labelScale;
+        s.labelH = labelH;
+        s.labelV = labelV;
+        s.showIcon = showIcon;
+        return s;
+    }
+
+    public int effectiveH() {
+        return labelH >= 0 ? labelH : 0;
+    }
+
+    public int effectiveV(boolean card) {
+        return labelV >= 0 ? labelV : (card ? 2 : 1);
+    }
+
+    /** The label colour to use; {@code defaultColor} applies only to the plain glass style. */
+    public int resolveLabelColor(boolean solid, int tint, boolean hasImage, int defaultColor) {
+        if (labelColor != 0) {
+            return labelColor;
+        }
+        if (hasImage) {
+            return Color.WHITE;
+        }
+        if (solid) {
+            return ColorUtils.calculateLuminance(tint) > 0.55
+                    ? Color.argb(230, 20, 20, 20) : Color.WHITE;
+        }
+        return defaultColor;
+    }
+
+    // ---------------------------------------------------------------- storage
+
+    public static SuperIconSettings load(Context context, long id) {
+        SuperIconSettings s = new SuperIconSettings();
+        String json = prefs(context).getString(key(id), null);
+        if (json == null) {
+            return s;
+        }
+        try {
+            JSONObject o = new JSONObject(json);
+            s.imageZoom = clamp((float) o.optDouble("zoom", 1), 1f, 3f);
+            s.imageX = clamp((float) o.optDouble("x", 0), -1f, 1f);
+            s.imageY = clamp((float) o.optDouble("y", 0), -1f, 1f);
+            s.imageDim = Math.max(0, Math.min(80, o.optInt("dim", 35)));
+            s.labelColor = o.optInt("color", 0);
+            s.labelScale = clamp((float) o.optDouble("scale", 1), 0.5f, 1.6f);
+            s.labelH = Math.max(-1, Math.min(2, o.optInt("h", -1)));
+            s.labelV = Math.max(-1, Math.min(2, o.optInt("v", -1)));
+            s.showIcon = o.optBoolean("icon", true);
+        } catch (JSONException e) {
+            return new SuperIconSettings();
+        }
+        return s;
+    }
+
+    public void save(Context context, long id) {
+        try {
+            JSONObject o = new JSONObject();
+            o.put("zoom", imageZoom);
+            o.put("x", imageX);
+            o.put("y", imageY);
+            o.put("dim", imageDim);
+            o.put("color", labelColor);
+            o.put("scale", labelScale);
+            o.put("h", labelH);
+            o.put("v", labelV);
+            o.put("icon", showIcon);
+            prefs(context).edit().putString(key(id), o.toString()).apply();
+        } catch (JSONException e) {
+            // Nothing sensible to do; the previous settings stay in place
+        }
+    }
+
+    public static void delete(Context context, long id) {
+        prefs(context).edit().remove(key(id)).apply();
+        imageFile(context, id).delete();
+        tempImageFile(context, id).delete();
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getApplicationContext().getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    private static String key(long id) {
+        return "s_" + id;
+    }
+
+    // ----------------------------------------------------------------- images
+
+    private static File dir(Context context) {
+        File d = new File(context.getFilesDir(), "supericon");
+        if (!d.exists()) {
+            d.mkdirs();
+        }
+        return d;
+    }
+
+    public static File imageFile(Context context, long id) {
+        return new File(dir(context), id + ".png");
+    }
+
+    public static File tempImageFile(Context context, long id) {
+        return new File(dir(context), id + ".tmp.png");
+    }
+
+    /** The saved background image of an item, or null. */
+    public static Bitmap loadImage(Context context, long id) {
+        return decodeCached(imageFile(context, id));
+    }
+
+    public static Bitmap decodeCached(File f) {
+        if (f == null || !f.exists()) {
+            return null;
+        }
+        String k = f.getAbsolutePath() + "@" + f.lastModified() + "/" + f.length();
+        Bitmap b = sImages.get(k);
+        if (b == null) {
+            b = BitmapFactory.decodeFile(f.getAbsolutePath());
+            if (b != null) {
+                sImages.put(k, b);
+            }
+        }
+        return b;
+    }
+
+    /** Decodes the picked image at a reduced size and writes it to {@code dest} as a PNG. */
+    public static boolean importImage(Context context, Uri uri, File dest) {
+        try {
+            BitmapFactory.Options o = new BitmapFactory.Options();
+            o.inJustDecodeBounds = true;
+            try (InputStream in = context.getContentResolver().openInputStream(uri)) {
+                BitmapFactory.decodeStream(in, null, o);
+            }
+            int sample = 1;
+            int longest = Math.max(o.outWidth, o.outHeight);
+            while (longest / sample > MAX_IMAGE_SIDE * 2) {
+                sample *= 2;
+            }
+            o = new BitmapFactory.Options();
+            o.inSampleSize = sample;
+            Bitmap bmp;
+            try (InputStream in = context.getContentResolver().openInputStream(uri)) {
+                bmp = BitmapFactory.decodeStream(in, null, o);
+            }
+            if (bmp == null) {
+                return false;
+            }
+            int side = Math.max(bmp.getWidth(), bmp.getHeight());
+            if (side > MAX_IMAGE_SIDE) {
+                float f = MAX_IMAGE_SIDE / (float) side;
+                bmp = Bitmap.createScaledBitmap(bmp, Math.max(1, Math.round(bmp.getWidth() * f)),
+                        Math.max(1, Math.round(bmp.getHeight() * f)), true);
+            }
+            dest.getParentFile().mkdirs();
+            try (FileOutputStream out = new FileOutputStream(dest)) {
+                bmp.compress(Bitmap.CompressFormat.PNG, 100, out);
+            }
+            return true;
+        } catch (IOException | RuntimeException | OutOfMemoryError e) {
+            return false;
+        }
+    }
+
+    /** Draws the image cropped to the rounded pill, with the given zoom, pan and dimming. */
+    public static void drawImage(Canvas canvas, Bitmap bmp, RectF pill, float radius,
+            SuperIconSettings s) {
+        float bw = bmp.getWidth();
+        float bh = bmp.getHeight();
+        float scale = Math.max(pill.width() / bw, pill.height() / bh) * s.imageZoom;
+        float sw = bw * scale;
+        float sh = bh * scale;
+        float maxX = (sw - pill.width()) / 2f;
+        float maxY = (sh - pill.height()) / 2f;
+        float left = pill.centerX() - sw / 2f + s.imageX * maxX;
+        float top = pill.centerY() - sh / 2f + s.imageY * maxY;
+        sClip.reset();
+        sClip.addRoundRect(pill, radius, radius, Path.Direction.CW);
+        canvas.save();
+        canvas.clipPath(sClip);
+        sDst.set(left, top, left + sw, top + sh);
+        canvas.drawBitmap(bmp, null, sDst, sImagePaint);
+        if (s.imageDim > 0) {
+            sDimPaint.setColor(Color.argb(s.imageDim * 255 / 100, 0, 0, 0));
+            canvas.drawRect(pill, sDimPaint);
+        }
+        canvas.restore();
+    }
+
+    // -------------------------------------------------------------- listeners
+
+    public static void addListener(Listener l) {
+        synchronized (sListeners) {
+            sListeners.add(l);
+        }
+    }
+
+    public static void removeListener(Listener l) {
+        synchronized (sListeners) {
+            sListeners.remove(l);
+        }
+    }
+
+    public static void notifyChanged(long id) {
+        ArrayList<Listener> copy;
+        synchronized (sListeners) {
+            copy = new ArrayList<>(sListeners);
+        }
+        for (Listener l : copy) {
+            l.onSuperIconSettingsChanged(id);
+        }
+    }
+
+    private static float clamp(float v, float min, float max) {
+        return Math.max(min, Math.min(max, v));
+    }
+}
