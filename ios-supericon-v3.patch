+    private int chipAt(float x, float y) {
+        float slop = 4 * mDensity;
+        for (int i = 0; i < mLayout.chipCountFit && i < mChips.size(); i++) {
+            RectF r = mLayout.chips[i];
+            if (x >= r.left - slop && x <= r.right + slop
+                    && y >= r.top - slop && y <= r.bottom + slop) {
+                return i;
+            }
+        }
+        return -1;
+    }
