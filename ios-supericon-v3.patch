+            }
+        });
+        root.addView(mHex);
+
+        // ---- background image
+        root.addView(section("Gambar latar"));
+        LinearLayout imgButtons = row();
+        imgButtons.addView(button("Pilih gambar", v -> pickImage()), weight());
+        imgButtons.addView(button("Hapus gambar", v -> {
+            mPreview.image = null;
+            mRemoveImage = true;
