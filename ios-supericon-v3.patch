+    // --------------------------------------------------------------- actions
+
+    private void pickImage() {
+        Intent i = new Intent(Intent.ACTION_GET_CONTENT);
+        i.setType("image/*");
+        i.addCategory(Intent.CATEGORY_OPENABLE);
+        try {
+            startActivityForResult(i, REQ_PICK);
+        } catch (RuntimeException e) {
+            Toast.makeText(this, "Tidak ada aplikasi untuk memilih gambar", Toast.LENGTH_SHORT)
+                    .show();
+        }
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (requestCode != REQ_PICK || resultCode != RESULT_OK || data == null
+                || data.getData() == null) {
+            return;
+        }
+        final Context ctx = getApplicationContext();
+        final File dest = SuperIconSettings.tempImageFile(ctx, mId);
+        final Uri uri = data.getData();
+        new Thread(() -> {
+            final boolean ok = SuperIconSettings.importImage(ctx, uri, dest);
+            runOnUiThread(() -> {
+                if (isFinishing()) {
+                    return;
+                }
+                Bitmap b = ok ? BitmapFactory.decodeFile(dest.getAbsolutePath()) : null;
+                if (b == null) {
+                    Toast.makeText(this, "Gambar tidak bisa dibuka", Toast.LENGTH_SHORT).show();
+                    return;
+                }
+                mPending = dest;
+                mRemoveImage = false;
+                mPreview.image = b;
+                mPreview.invalidate();
+            });
+        }).start();
+    }
+
+    private void resetAll() {
+        mSettings = new SuperIconSettings();
+        mPreview.image = null;
+        mRemoveImage = true;
+        if (mPending != null) {
+            mPending.delete();
+            mPending = null;
+        }
+        syncControls();
+    }
+
+    private void cancel() {
+        SuperIconSettings.tempImageFile(this, mId).delete();
+        finish();
+    }
+
+    private void save() {
+        File fin = SuperIconSettings.imageFile(this, mId);
+        if (mRemoveImage) {
+            fin.delete();
+            mRemoveImage = false;
+        }
+        if (mPending != null && mPending.exists()) {
+            fin.delete();
+            if (!mPending.renameTo(fin)) {
+                Toast.makeText(this, "Gambar gagal disimpan", Toast.LENGTH_SHORT).show();
+            }
+            mPending = null;
+        }
+        mSettings.save(this, mId);
+
+        boolean resized = mPreview.sx != mOrigSx || mPreview.sy != mOrigSy
+                || mSolidStyle != mOrigSolid;
+        if (resized) {
+            String error = SuperIconMenu.resizeFromEditor((int) mId,
+                    mSolidStyle ? WorkspaceItemInfo.SUPER_STYLE_SOLID
+                            : WorkspaceItemInfo.SUPER_STYLE_SIDE,
+                    mPreview.sx, mPreview.sy);
+            if (error != null) {
+                // Stay open so another size can be chosen; the other settings are saved
+                Toast.makeText(this, error, Toast.LENGTH_LONG).show();
+                SuperIconSettings.notifyChanged(mId);
+                return;
+            }
+            mOrigSx = mPreview.sx;
+            mOrigSy = mPreview.sy;
+            mOrigSolid = mSolidStyle;
+        }
+        SuperIconSettings.notifyChanged(mId);
+        finish();
+    }
+
+    @Override
+    protected void onDestroy() {
+        super.onDestroy();
+        if (mId >= 0 && !isChangingConfigurations()) {
+            SuperIconSettings.tempImageFile(this, mId).delete();
+        }
+    }
