+        mPreview.solidStyle = mSolidStyle;
+        mPreview.settings = mSettings;
+        mPreview.image = SuperIconSettings.loadImage(this, mId);
+
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        int pad = (int) (16 * mD);
+        root.setPadding(pad, pad, pad, pad);
+
+        TextView title = new TextView(this);
+        title.setText("Sesuaikan supericon");
+        title.setTextSize(20);
+        root.addView(title);
+
+        LinearLayout.LayoutParams pl = new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        pl.topMargin = pad;
+        pl.bottomMargin = pad / 2;
+        root.addView(mPreview, pl);
+
+        // ---- size and style
+        root.addView(section("Ukuran dan gaya"));
+        mSizeGroup = radios(SIZE_NAMES, true, i -> {
+            mPreview.sx = SIZES[i][0];
