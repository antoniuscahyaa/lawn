+        float bh = bmp.getHeight();
+        float scale = Math.max(pill.width() / bw, pill.height() / bh) * s.imageZoom;
+        float sw = bw * scale;
+        float sh = bh * scale;
+        float rangeX = Math.abs(sw - pill.width()) / 2f;
+        float rangeY = Math.abs(sh - pill.height()) / 2f;
+        float left = pill.centerX() - sw / 2f + s.imageX * rangeX;
+        float top = pill.centerY() - sh / 2f + s.imageY * rangeY;
+        sClip.reset();
