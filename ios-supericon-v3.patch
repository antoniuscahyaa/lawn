+        mStyleGroup = radios(new String[] {"Kaca", "Warna"}, true, i -> {
+            mSolidStyle = i == 1;
+            mPreview.solidStyle = mSolidStyle;
+            mPreview.invalidate();
+        });
+        root.addView(mStyleGroup);
+
+        // ---- background colour
+        root.addView(section("Warna latar"));
+        mBgGroup = radios(new String[] {"Sesuai gaya", "Adaptif (warna ikon aplikasi)",
+                "Warna kustom (hex)"}, false, i -> {
+            mSettings.bgMode = i;
+            mHex.setEnabled(i == SuperIconSettings.BG_CUSTOM);
