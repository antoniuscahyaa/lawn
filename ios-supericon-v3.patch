+        mPreview.sy = Math.max(1, in.getIntExtra(EXTRA_SPAN_Y, 1));
+        mOrigSx = mPreview.sx;
+        mOrigSy = mPreview.sy;
+        mPreview.cellW = Math.max(1, in.getIntExtra(EXTRA_CELL_W, 1));
+        mPreview.cellH = Math.max(1, in.getIntExtra(EXTRA_CELL_H, 1));
+        mPreview.regular = in.getIntExtra(EXTRA_REGULAR, (int) (56 * mD));
+        mPreview.baseText = in.getFloatExtra(EXTRA_TEXT_SIZE, 12 * mD);
+        mPreview.tint = in.getIntExtra(EXTRA_TINT, 0xFF5F5E5A);
+        mPreview.defColor = in.getIntExtra(EXTRA_DEFAULT_COLOR, Color.WHITE);
