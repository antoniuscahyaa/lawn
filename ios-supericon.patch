+package com.android.launcher3.popup;
+
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.view.View;
+import android.widget.Toast;
+
+import com.android.launcher3.CellLayout;
+import com.android.launcher3.Launcher;
+import com.android.launcher3.R;
+import com.android.launcher3.ShortcutAndWidgetContainer;
+import com.android.launcher3.WorkspaceItemInfo;
+import com.android.launcher3.views.OptionsPopupView;
+import com.android.launcher3.views.OptionsPopupView.OptionItem;
+
+import java.util.ArrayList;
+
+/**
+ * Menu for turning a workspace app icon into a 2x1 supericon and choosing its style.
+ */
+public final class SuperIconMenu {
+
+    private SuperIconMenu() { }
+
+    public static void show(Launcher launcher, WorkspaceItemInfo info) {
+        View icon = launcher.getWorkspace().getHomescreenIconByItemId(info.id);
+        if (icon == null) {
+            return;
+        }
+        Rect rect = new Rect();
+        launcher.getDragLayer().getDescendantRectRelativeToSelf(icon, rect);
+
+        final boolean isSuper = info.isSuperIcon();
+        final int current = isSuper ? info.superStyle : WorkspaceItemInfo.SUPER_NONE;
+        final int[] styles = {
+                WorkspaceItemInfo.SUPER_STYLE_SIDE,
+                WorkspaceItemInfo.SUPER_STYLE_BACKDROP,
+                WorkspaceItemInfo.SUPER_STYLE_CARD};
+        final int[] labels = {
+                R.string.supericon_style_side,
+                R.string.supericon_style_backdrop,
+                R.string.supericon_style_card};
+
+        ArrayList<OptionItem> items = new ArrayList<>();
+        if (isSuper) {
+            items.add(new OptionItem(R.string.supericon_size_normal, R.drawable.ic_widget, 0,
+                    v -> {
+                        apply(launcher, info, WorkspaceItemInfo.SUPER_NONE);
+                        return true;
+                    }));
+        }
+        for (int i = 0; i < styles.length; i++) {
+            final int style = styles[i];
+            if (style == current) {
+                continue;
+            }
+            items.add(new OptionItem(
+                    isSuper ? labels[i] : R.string.supericon_size_wide,
+                    R.drawable.ic_widget, 0,
+                    v -> {
+                        apply(launcher, info, style);
+                        return true;
+                    }));
+            if (!isSuper) {
+                // A regular icon gets a single entry that turns it into a 2x1 supericon
+                // (style A); the style can be changed afterwards from the same menu.
+                break;
+            }
+        }
+        OptionsPopupView.show(launcher, new RectF(rect), items);
+    }
+
+    private static void apply(Launcher launcher, WorkspaceItemInfo info, int newStyle) {
+        View old = launcher.getWorkspace().getHomescreenIconByItemId(info.id);
+        if (old == null || !(old.getParent() instanceof ShortcutAndWidgetContainer)
+                || !(old.getParent().getParent() instanceof CellLayout)) {
+            return;
+        }
+        CellLayout layout = (CellLayout) old.getParent().getParent();
+        CellLayout.LayoutParams lp = (CellLayout.LayoutParams) old.getLayoutParams();
+        final int newSpan = newStyle == WorkspaceItemInfo.SUPER_NONE ? 1 : 2;
+        int newX = lp.cellX;
+
+        if (newSpan == 2 && info.spanX < 2) {
+            layout.markCellsAsUnoccupiedForView(old);
+            boolean right = lp.cellX + 1 < layout.getCountX()
+                    && layout.isRegionVacant(lp.cellX + 1, lp.cellY, 1, 1);
+            boolean left = !right && lp.cellX - 1 >= 0
+                    && layout.isRegionVacant(lp.cellX - 1, lp.cellY, 1, 1);
+            layout.markCellsAsOccupiedForView(old);
+            if (!right && !left) {
+                Toast.makeText(launcher, R.string.supericon_no_space, Toast.LENGTH_SHORT).show();
+                return;
+            }
+            if (left) {
+                newX = lp.cellX - 1;
+            }
+        }
+
+        layout.removeView(old);
+        info.superStyle = newStyle;
+        launcher.getModelWriter().modifyItemInDatabase(info, info.container, info.screenId,
+                newX, lp.cellY, newSpan, 1);
+        launcher.getModelWriter().updateItemInDatabase(info);
+
+        View view = launcher.createShortcut(layout, info);
+        launcher.getWorkspace().addInScreen(view, info);
+    }
+}
diff -ruN a/src/com/android/launcher3/views/SuperIconView.java b/src/com/android/launcher3/views/SuperIconView.java
